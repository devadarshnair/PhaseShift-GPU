+  // PhaseShift (patch dxa-class) PS_DXA_REPORT line; cumulative since device open (one launch per app run here).
+  PsClassCollect col;
+  for (auto& cluster : clusters_)
+    cluster->ps_collect(col);
+  auto list = [](const uint64_t* v, uint32_t n) {
+    std::string out;
+    for (uint32_t i = 0; i < n; ++i) {
+      if (i) out += ",";
+      out += std::to_string(v[i]);
+    }
+    return out;
+  };
+  std::cout << "PSDXAC launch=" << (phase_launches_ ? phase_launches_ - 1 : 0)
+            << " gmem_reqs=" << list(col.dxa_gmem, VX_PS_NUM_CLASSES)
+            << " max_inflight=" << list(col.dxa_cls_max_inflight, VX_PS_NUM_CLASSES)
+            << " cap_stalls=" << list(col.dxa_cls_cap_stalls, VX_PS_NUM_CLASSES)
+            << " l2only_reads=" << col.dxa_l2only_reads << " l2only_dropped=" << col.dxa_l2only_dropped
+            << " lmem_writes=" << col.dxa_lmem_writes << " transfers=" << col.dxa_transfers
+            << " mc_transfers=" << col.dxa_mc_transfers << " mc_replay_beats=" << col.dxa_mc_replay_beats
+            << std::endl;
+}
