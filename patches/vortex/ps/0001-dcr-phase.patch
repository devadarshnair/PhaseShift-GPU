diff --git a/VX_types.toml b/VX_types.toml
index 80ec9c17f..7d9cd3c92 100644
--- a/VX_types.toml
+++ b/VX_types.toml
@@ -116,6 +116,40 @@ VX_DCR_KMU_CLUSTER_DIM_Y= 0x022
 VX_DCR_KMU_CLUSTER_DIM_Z= 0x023
 VX_DCR_KMU_STATE_END    = 0x024
 
+# PhaseShift [dcr_phase] block (ps patch dcr-phase). Lives in the free DCR range 0x024-0x03F
+# (KMU ends at 0x024 exclusive; TEX starts at 0x040); it starts at 0x028, leaving 0x024-0x027 as a guard after the
+# KMU block. SimX latches it into every cache level, the DRAM model and DXA (sim/common/phase_config.h); the
+# latched value survives the per-launch reset. All-zero (the reset value) = stock behaviour. Unknown DCRs are
+# ignored by the base tree (Core::dcr_write), so host code that writes this block also runs there.
+# 64-bit addresses are LO/HI word pairs; ranges are [base, limit).
+[dcr_phase]
+VX_DCR_PHASE_STATE_BEGIN    = 0x028
+VX_DCR_PHASE_MODE           = 0x028  # global mode / phase id (0 = off)
+VX_DCR_PHASE_FLAGS          = 0x029  # bit 0: persist_l2 (VX_PHASE_FLAG_PERSIST_L2)
+VX_DCR_PHASE_L1_WAYMASK     = 0x02A  # L1 dcache allowed ways (0 = all)
+VX_DCR_PHASE_L2_WAYMASK     = 0x02B  # L2 allowed ways (0 = all)
+VX_DCR_PHASE_INSERT_POLICY  = 0x02C  # L2 insertion policy id (0 = stock)
+VX_DCR_PHASE_DXA_DEPTH0     = 0x02D  # DXA depth, classes 0-3, 8 bits each (0 = stock)
+VX_DCR_PHASE_DXA_DEPTH1     = 0x02E  # DXA depth, classes 4-7, 8 bits each (0 = stock)
+VX_DCR_PHASE_DRAM_SCHED     = 0x02F  # DRAM scheduler mode (0 = stock)
+VX_DCR_PHASE_DRAM_AGING     = 0x030  # DRAM aging window, cycles (0 = none)
+VX_DCR_PHASE_KV0_BASE_LO    = 0x031
+VX_DCR_PHASE_KV0_BASE_HI    = 0x032
+VX_DCR_PHASE_KV0_LIMIT_LO   = 0x033
+VX_DCR_PHASE_KV0_LIMIT_HI   = 0x034
+VX_DCR_PHASE_KV1_BASE_LO    = 0x035
+VX_DCR_PHASE_KV1_BASE_HI    = 0x036
+VX_DCR_PHASE_KV1_LIMIT_LO   = 0x037
+VX_DCR_PHASE_KV1_LIMIT_HI   = 0x038
+VX_DCR_PHASE_WGT_BASE_LO    = 0x039
+VX_DCR_PHASE_WGT_BASE_HI    = 0x03A
+VX_DCR_PHASE_WGT_LIMIT_LO   = 0x03B
+VX_DCR_PHASE_WGT_LIMIT_HI   = 0x03C
+VX_DCR_PHASE_STATE_END      = 0x03D
+
+[phase_const]
+VX_PHASE_FLAG_PERSIST_L2    = 0x1
+
 # DXA descriptor DCR mapping
 # access pattern:
 #   VX_DCR_DXA_DESC_BASE + slot * VX_DCR_DXA_DESC_STRIDE + field_off
