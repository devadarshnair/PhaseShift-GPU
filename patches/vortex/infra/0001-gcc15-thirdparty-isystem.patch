diff --git a/sim/simx/Makefile b/sim/simx/Makefile
index 4338c8ab6..afd388b4e 100644
--- a/sim/simx/Makefile
+++ b/sim/simx/Makefile
@@ -20,8 +20,11 @@ CXXFLAGS += -std=c++17 -Wall -Wextra -Wfatal-errors -Werror
 CXXFLAGS += -fPIC
 CXXFLAGS += -I$(SRC_DIR) -I$(SRC_DIR)/dxa -I$(SRC_DIR)/tex -I$(SRC_DIR)/om -I$(SRC_DIR)/raster -I$(SRC_DIR)/rtu -I$(SRC_DIR)/kmu -I$(SRC_DIR)/mem -I$(SRC_DIR)/dtm -I$(SW_COMMON_DIR) -I$(SIM_COMMON_DIR) -I$(ROOT_DIR)/sw -I$(ROOT_DIR)/hw -I$(THIRD_PARTY_DIR)
 CXXFLAGS += -I$(THIRD_PARTY_DIR)/softfloat/source/include
-CXXFLAGS += -I$(THIRD_PARTY_DIR)/ramulator/ext/spdlog/include
-CXXFLAGS += -I$(THIRD_PARTY_DIR)/ramulator/ext/yaml-cpp/include
+# PhaseShift infra patch 0001: Ramulator's FetchContent deps (spdlog v1.11.0 bundles fmt v9, yaml-cpp 0.7.0) are
+# third-party headers; -isystem keeps host GCC >= 13 warnings in them (e.g. fmt's -Wdangling-reference false
+# positive under GCC 15) from failing -Werror, while Vortex's own code stays under -Werror.
+CXXFLAGS += -isystem $(THIRD_PARTY_DIR)/ramulator/ext/spdlog/include
+CXXFLAGS += -isystem $(THIRD_PARTY_DIR)/ramulator/ext/yaml-cpp/include
 CXXFLAGS += -I$(THIRD_PARTY_DIR)/ramulator/src
 CXXFLAGS += -DVX_CFG_XLEN=$(XLEN) -DVX_CFG_XLEN_$(XLEN)
 CXXFLAGS += $(CONFIGS)
