diff --git a/hw/rtl/core/VX_dot4_lane.sv b/hw/rtl/core/VX_dot4_lane.sv
new file mode 100644
index 000000000..0a20dc206
--- /dev/null
+++ b/hw/rtl/core/VX_dot4_lane.sv
@@ -0,0 +1,20 @@
+// PhaseShift: one lane of the DP4A-class int8 dot product.
+//   y = sum_{k=0..3} int8(a.byte[k]) * int8(b.byte[k])  (+ acc when use_acc)       exact 32-bit integer arithmetic
+// |sum| <= 4 * 128 * 128 = 65536 fits in 18 signed bits; the optional accumulate adds the third register source.
+// Written behaviourally on purpose (four signed 8x8 `*` and an adder tree): the cost measured by the synthesis flow is
+// the flow's default lowering of `*`/`+`, the same lowering every other multiplier/adder in the core gets (consistent flow).
+
+module VX_dot4_lane (
+    input  wire [31:0] a,
+    input  wire [31:0] b,
+    input  wire [31:0] acc,
+    input  wire        use_acc,
+    output wire [31:0] y
+);
+    wire signed [15:0] p0 = $signed(a[ 7: 0]) * $signed(b[ 7: 0]);
+    wire signed [15:0] p1 = $signed(a[15: 8]) * $signed(b[15: 8]);
+    wire signed [15:0] p2 = $signed(a[23:16]) * $signed(b[23:16]);
+    wire signed [15:0] p3 = $signed(a[31:24]) * $signed(b[31:24]);
+    wire signed [17:0] s  = 18'(p0) + 18'(p1) + 18'(p2) + 18'(p3);
+    assign y = 32'($signed(s)) + (use_acc ? acc : 32'd0);
+endmodule
