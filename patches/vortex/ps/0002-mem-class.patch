+void ProcessorImpl::ps_class_report(const char* when) const {
+  // PhaseShift (patch mem-class) PS_DEBUG_CLASS report; parsed by scripts/psclass.py. All counters are cumulative since
+  // device open except the ps_mark counts, which are per launch. Byte counts: one DRAM request = one block.
+  const uint64_t launch = phase_launches_ ? phase_launches_ - 1 : 0;
+  const uint64_t blk = memsim_->block_size();
+  auto list = [](const uint64_t* v, uint32_t n) {
+    std::string out;
+    for (uint32_t i = 0; i < n; ++i) {
+      if (i) out += ",";
+      out += std::to_string(v[i]);
+    }
+    return out;
+  };
+  uint64_t rd[VX_PS_NUM_CLASSES], wr[VX_PS_NUM_CLASSES];
+  for (uint32_t c = 0; c < VX_PS_NUM_CLASSES; ++c) {
+    rd[c] = memsim_->ps_class_bytes(c, false);
+    wr[c] = memsim_->ps_class_bytes(c, true);
+  }
+  std::cout << "PSCLASS launch=" << launch << " when=" << when << " block=" << blk
+            << " dram_total_bytes=" << (perf_mem_reads_ + perf_mem_writes_) * blk
+            << " dram_rd_bytes=" << list(rd, VX_PS_NUM_CLASSES)
+            << " dram_wr_bytes=" << list(wr, VX_PS_NUM_CLASSES) << std::endl;
+  static const char* const kRegion[PhaseConfig::NUM_REGIONS] = {"kv0", "kv1", "wgt", "other"};
+  for (uint32_t r = 0; r < PhaseConfig::NUM_REGIONS; ++r) {
+    uint64_t b[VX_PS_NUM_CLASSES];
+    for (uint32_t c = 0; c < VX_PS_NUM_CLASSES; ++c)
+      b[c] = memsim_->ps_region_bytes(r, c);
+    std::cout << "PSCLASS-REGION launch=" << launch << " when=" << when << " region=" << kRegion[r]
+              << " bytes=" << list(b, VX_PS_NUM_CLASSES) << std::endl;
+  }
+  PsClassCollect col;
+  for (auto& cluster : clusters_)
+    cluster->ps_collect(col);
+  Cache::PsClassStats l3 = l3cache_->ps_class_stats();
+  const std::pair<const char*, const Cache::PsClassStats*> levels[] = {
+    {"l1i", &col.l1i}, {"l1d", &col.l1d}, {"l2", &col.l2}, {"l3", &l3}};
+  for (auto& lv : levels) {
+    std::cout << "PSCLASS-CACHE launch=" << launch << " when=" << when << " level=" << lv.first
+              << " reqs=" << list(lv.second->reqs, VX_PS_NUM_CLASSES)
+              << " mixed_merges=" << lv.second->mixed_merges
+              << " prio_upgrades=" << lv.second->prio_upgrades << std::endl;
+  }
+  std::cout << "PSCLASS-DXA launch=" << launch << " when=" << when
+            << " gmem_reqs=" << list(col.dxa_gmem, VX_PS_NUM_CLASSES) << std::endl;
+  uint64_t tot[VX_PS_NUM_MARK_TYPES] = {};
+  for (auto& cm : col.marks) {
+    std::cout << "PSMARK launch=" << launch << " when=" << when << " core=" << cm.first
+              << " counts=" << list(cm.second.data(), VX_PS_NUM_MARK_TYPES) << std::endl;
+    for (uint32_t t = 0; t < VX_PS_NUM_MARK_TYPES; ++t)
+      tot[t] += cm.second[t];
+  }
+  std::cout << "PSMARK-TOTAL launch=" << launch << " when=" << when
+            << " counts=" << list(tot, VX_PS_NUM_MARK_TYPES) << std::endl;
+}
