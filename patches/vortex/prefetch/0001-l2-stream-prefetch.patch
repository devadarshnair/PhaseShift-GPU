+  // ============================================================================================================
+  // PhaseShift (patch l2-stream-prefetch): L2 tagged next-N-sector stream prefetcher (per bank).
+  //
+  // Policy (all knobs from the environment, read once; PS_PF_DEPTH = 0 or an L2 not marked prefetch-capable = OFF and
+  // the bank is bit-identical to stock):
+  //   * On a demand READ MISS to sector A that allocates a fill, queue A+1 .. A+DEPTH (the next DEPTH sectors of this
+  //     bank in address order: the sector after the last one of a line is the first sector of the next line of this
+  //     bank, i.e. + num_banks lines).  [trigger 1 = PS_PF_TRIG bit 0]
+  //   * On the first demand READ HIT to a sector that a prefetch installed (tag bit ps_pf), queue STEP more sectors
+  //     DEPTH sectors ahead (B+DEPTH .. B+DEPTH+STEP-1), so the window stays DEPTH sectors in front of a
+  //     sequential stream (the classic tagged sequential prefetcher).   [trigger 2 = PS_PF_TRIG bit 1]
+  //   * A queued candidate is issued when the bank has an egress slot and MSHR occupancy (entries + in-pipe requests)
+  //     is below capacity - PS_PF_RESERVE (those slots are kept for demand misses); candidates whose sector is
+  //     resident, in flight or in the bank pipe are dropped ("redundant"). A prefetch is an MSHR-rooted read with no
+  //     requester (bank_req_t::pf): its fill installs the sector tagged ps_pf; no core response is ever sent.
+  // State (hardware cost): 1 tag bit per sector (sector_t::ps_pf) + 1 pf bit and 1 late bit per MSHR entry + a
+  // PS_PF_QSIZE-entry candidate queue (sector address + 3-bit class) + a few counters. No per-stream table.
+  // Counters (cumulative over launches, like the MPM counters; printed as "PSPF" lines when the bank is destroyed):
+  //   issued   fills sent for prefetches          filled  prefetch fills installed
+  //   useful   first demand hit on a prefetched sector = TIMELY prefetches (the data was there before the demand)
+  //   late     a demand joined the prefetch's in-flight chain (useful, but only part of the latency was hidden)
+  //   unused   prefetched sectors evicted (unused_evict) or still resident at exit (unused_end) without a demand touch
+  //   polluting: evictions of valid non-prefetched sectors by prefetch fills (poll_evict, by victim class), and the
+  //            demand misses that hit a recorded such victim afterwards (poll_miss, by the missing request's class;
+  //            bounded 8192-entry record: instrumentation, not hardware)
+  // ============================================================================================================
+  struct pf_cfg_t {
+    uint32_t depth = 0, step = 1, qsize = 8, reserve = 4, trig = 3;
+  };
+  static const pf_cfg_t &pf_cfg() {
+    static pf_cfg_t c = [] {
+      pf_cfg_t x;
+      auto env = [](const char *n, uint32_t d) { const char *e = std::getenv(n); return (e && e[0]) ? (uint32_t)std::strtoul(e, nullptr, 10) : d; };
+      x.depth = env("PS_PF_DEPTH", 0); x.step = env("PS_PF_STEP", 1); x.qsize = env("PS_PF_QSIZE", 8);
+      x.reserve = env("PS_PF_RESERVE", 4); x.trig = env("PS_PF_TRIG", 3);
+      return x;
+    }();
+    return c;
+  }
+  bool pf_on() const { return pf_cfg().depth != 0 && ps_owner_ != nullptr && ps_owner_->ps_pf_capable(); }
+
+  struct pf_ent_t { uint64_t addr; uint8_t cls; };
+  struct pf_stats_t {
+    uint64_t trig_miss = 0, trig_hit = 0, queued = 0, q_drop = 0, redundant = 0, issued = 0, filled = 0, useful = 0, late = 0;
+    uint64_t unused_evict = 0, unused_end = 0, poll_evict[VX_PS_NUM_CLASSES] = {}, poll_miss[VX_PS_NUM_CLASSES] = {};
+  };
+  pf_stats_t pf_st_;
+  std::deque<pf_ent_t> pf_q_;
+  std::unordered_map<uint64_t, uint8_t> pf_poll_;   // sector address -> victim class (bounded FIFO below)
+  std::deque<uint64_t> pf_poll_fifo_;
+
+  uint64_t pf_next(uint64_t addr) const {   // next sector of THIS bank in address order
+    const uint64_t sect = uint64_t(1) << config_.S, line = uint64_t(1) << config_.L, a = addr & ~(sect - 1);
+    const uint32_t sid = params_.addr_sector_id(a);
+    if (sid + 1 < params_.sectors_per_line) return a + sect;
+    return a + sect + (line << config_.B) - line;   // first sector of the line num_banks lines further
+  }
+  void pf_trigger(uint64_t addr, uint32_t cls, bool miss) {
+    if (!pf_on()) return;
+    const pf_cfg_t &c = pf_cfg();
+    if (!(c.trig & (miss ? 1u : 2u))) return;
+    ++(miss ? pf_st_.trig_miss : pf_st_.trig_hit);
+    uint64_t a = addr;
+    uint32_t n = miss ? c.depth : c.step;
+    if (!miss) for (uint32_t i = 0; i < c.depth; ++i) a = pf_next(a);
+    for (uint32_t i = 0; i < n; ++i) {
+      if (miss) a = pf_next(a);
+      if (pf_q_.size() >= c.qsize) { ++pf_st_.q_drop; break; }
+      pf_q_.push_back({a, uint8_t(cls & (VX_PS_NUM_CLASSES - 1))});
+      ++pf_st_.queued;
+      if (!miss) a = pf_next(a);
+    }
+  }
+  void pf_issue() {
+    if (pf_q_.empty() || !pf_on()) return;
+    if (this->mem_req_out.full()) return;
+    if (mshr_.size() + pending_mshr_size_ + pf_cfg().reserve >= mshr_.capacity()) return;
+    const pf_ent_t e = pf_q_.front();
+    pf_q_.pop_front();
+    const uint32_t set_id = params_.addr_set_id(e.addr), sector_id = params_.addr_sector_id(e.addr);
+    const uint64_t tag = params_.addr_tag(e.addr);
+    auto &set = sets_.at(set_id);
+    const int present = set.find_resident(tag);
+    bool red = (present != -1 && set.lines.at(present).sectors.at(sector_id).valid) || mshr_.lookup(set_id, tag, sector_id);
+    for (const auto &pl : pipe_core_lines_) if (pl.first == set_id && pl.second == tag) red = true;
+    if (red) { ++pf_st_.redundant; return; }
+    bank_req_t r;
+    r.reset();
+    r.type = bank_req_t::Core;
+    r.addr = e.addr;
+    r.pf = true;
+    r.adm_seq = adm_seq_ctr_++;
+    r.flags.mem_class = e.cls;
+    const int id = mshr_.enqueue(r, set_id, tag, sector_id);
+    MemReq fill;
+    fill.addr = params_.mem_addr_sector(bank_id_, set_id, tag, sector_id);
+    fill.tag = id;
+    fill.flags.mem_class = e.cls;
+    this->mem_req_out.send(fill, MEM_REQ_DELAY);
+    ++pending_fill_reqs_;
+    ++pf_st_.issued;
+  }
+  // a prefetch fill (fill_is_pf) is about to overwrite `v`: account unused prefetched sectors, record demand victims
+  void pf_on_evict(const line_t &v, uint32_t set_id, bool fill_is_pf) {
+    if (!pf_on()) return;
+    for (uint32_t s = 0; s < v.sectors.size(); ++s) {
+      const auto &sec = v.sectors.at(s);
+      if (!sec.valid) continue;
+      if (sec.ps_pf) { ++pf_st_.unused_evict; continue; }
+      if (!fill_is_pf) continue;
+      const uint64_t key = params_.mem_addr_sector(bank_id_, set_id, v.tag, s);
+      ++pf_st_.poll_evict[sec.ps_class & (VX_PS_NUM_CLASSES - 1)];
+      if (pf_poll_.emplace(key, sec.ps_class).second) {
+        pf_poll_fifo_.push_back(key);
+        if (pf_poll_fifo_.size() > 8192) { pf_poll_.erase(pf_poll_fifo_.front()); pf_poll_fifo_.pop_front(); }
+      }
+    }
+  }
+  void pf_check_poll(uint64_t addr, uint32_t cls) {
+    if (!pf_on() || pf_poll_.empty()) return;
+    const uint64_t key = addr & ~((uint64_t(1) << config_.S) - 1);
+    auto it = pf_poll_.find(key);
+    if (it == pf_poll_.end()) return;
+    ++pf_st_.poll_miss[cls & (VX_PS_NUM_CLASSES - 1)];
+    pf_poll_.erase(it);   // the stale key stays in the FIFO until it ages out; erase() of an absent key is harmless
+  }
+  void pf_report() {
+    if (!pf_on() || (pf_st_.trig_miss + pf_st_.trig_hit) == 0) return;
+    for (auto &set : sets_) for (auto &ln : set.lines) for (auto &sec : ln.sectors) if (sec.valid && sec.ps_pf) ++pf_st_.unused_end;
+    const pf_cfg_t &c = pf_cfg();
+    std::cout << "PSPF bank=" << this->name() << " depth=" << c.depth << " step=" << c.step << " qsize=" << c.qsize << " reserve=" << c.reserve
+              << " trig=" << c.trig << " trig_miss=" << pf_st_.trig_miss << " trig_hit=" << pf_st_.trig_hit << " queued=" << pf_st_.queued
+              << " q_drop=" << pf_st_.q_drop << " redundant=" << pf_st_.redundant << " issued=" << pf_st_.issued << " filled=" << pf_st_.filled
+              << " useful=" << pf_st_.useful << " late=" << pf_st_.late << " unused_evict=" << pf_st_.unused_evict << " unused_end=" << pf_st_.unused_end
+              << " poll_evict=[";
+    for (uint32_t k = 0; k < VX_PS_NUM_CLASSES; ++k) std::cout << (k ? "," : "") << pf_st_.poll_evict[k];
+    std::cout << "] poll_miss=[";
+    for (uint32_t k = 0; k < VX_PS_NUM_CLASSES; ++k) std::cout << (k ? "," : "") << pf_st_.poll_miss[k];
+    std::cout << "]" << std::endl;
+  }
