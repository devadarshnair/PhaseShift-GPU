 VX_DCR_MPM_CLASS_MEM     = 7
-VX_DCR_MPM_CLASS_RESERVED2= 8
+VX_DCR_MPM_CLASS_PHASESHIFT = 8  # ps patch ps-counters (was RESERVED2): PhaseShift counters, paged, see [ps_counters]
 VX_DCR_MPM_CLASS_RESERVED3= 9
 VX_DCR_MPM_CLASS_RESERVED4= 10
 VX_DCR_MPM_CLASS_TCU     = 11
@@ -656,6 +656,37 @@ VX_DCR_MPM_CLASS_OM      = 14
 VX_DCR_MPM_CLASS_RTU     = 15
 VX_DCR_MPM_CLASS_DXA     = 16
 
+# PhaseShift MPM class 8 (ps patch ps-counters, docs/methodology.md §12.9). The class has more counters
+# than one MPM window (CSR ids 3..31 = 29 counters), so it is PAGED: counter k is read with MPM class
+# (VX_DCR_MPM_CLASS_PHASESHIFT | (page << VX_PS_MPM_PAGE_SHIFT)), page = k / VX_PS_MPM_PAGE_SIZE, at CSR
+# VX_CSR_MPM_USER + k % VX_PS_MPM_PAGE_SIZE (the DCR tag carries 10 class bits; classes 0..16 need 5). Every counter is
+# device-wide (any core returns the same value) and cumulative since device open, except DXA_MAX_INFLIGHT (a maximum).
+# Per-class groups have VX_PS_NUM_CLASSES (8) entries, indexed by VX_PS_CLASS_*; MARKS by VX_PS_MARK_*.
+[ps_counters]
+VX_PS_MPM_PAGE_SHIFT        = 5
+VX_PS_MPM_PAGE_SIZE         = 29
+VX_PS_HIST_BUCKETS          = 16   # log2 buckets of the DRAM read wait: b0 = [0,2), bk = [2^k, 2^(k+1)), b15 = [2^15, inf)
+VX_PS_DXA_STREAMS           = 4    # DXA workers per DxaCore counted separately; workers >= 3 share slot 3
+VX_PS_CNT_L1L2_RD_BYTES     = 0    # [class] bytes of read requests entering the L2 (L1/DXA -> L2 link; one block each)
+VX_PS_CNT_L1L2_WR_BYTES     = 8    # [class] bytes of write requests entering the L2
+VX_PS_CNT_L2_ACCESSES       = 16   # [class] L2 bank accesses (= stock reads + writes)
+VX_PS_CNT_L2_MISSES         = 24   # [class] L2 misses (= stock read_misses + write_misses); hits = accesses - misses
+VX_PS_CNT_L2_FILLS_DEMOTED  = 32   # [class] L2 fills inserted at low priority (mechanism D, 0 in this patch)
+VX_PS_CNT_L2_FILLS_BYPASSED = 40   # [class] L2 fills not allocated (mechanism D, 0 in this patch)
+VX_PS_CNT_DRAM_RD_BYTES     = 48   # [class] DRAM read bytes (DramSim::send_request, one block each)
+VX_PS_CNT_DRAM_WR_BYTES     = 56   # [class] DRAM write bytes
+VX_PS_CNT_DRAM_OCC          = 64   # [class] DRAM occupancy integral: sum over DRAM-model cycles of requests in the model
+VX_PS_CNT_DRAM_BP           = 72   # [class] channel-cycles a request waited at the DRAM model input (model full)
+VX_PS_CNT_DRAM_RD_WAIT      = 80   # [class] sum of read residencies (accept -> response handed back), cycles
+VX_PS_CNT_DRAM_RD_DONE      = 88   # [class] completed reads
+VX_PS_CNT_DRAM_WR_WAIT      = 96   # [class] sum of write residencies, cycles
+VX_PS_CNT_DRAM_WR_DONE      = 104  # [class] completed writes
+VX_PS_CNT_MARKS             = 112  # [mark type] ps_mark work units, cumulative over launches
+VX_PS_CNT_DXA_BYTES         = 120  # [stream] DXA GMEM read bytes per worker slot
+VX_PS_CNT_DXA_MAX_INFLIGHT  = 124  # [stream] max GMEM reads in flight per worker (MAX, not a sum)
+VX_PS_CNT_DRAM_RD_HIST      = 128  # [class][bucket] DRAM read-wait histogram, index 128 + class * 16 + bucket
+VX_PS_CNT_NUM               = 256
+
 [csr_mpm_base]
 VX_CSR_MCYCLE = 0xB00
 VX_CSR_MCYCLE_H = 0xB80
