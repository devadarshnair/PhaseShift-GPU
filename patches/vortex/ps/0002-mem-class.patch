--- a/VX_types.toml
+++ b/VX_types.toml
@@ -149,6 +149,8 @@ VX_DCR_PHASE_STATE_END      = 0x03D
 
 [phase_const]
 VX_PHASE_FLAG_PERSIST_L2    = 0x1
+VX_PHASE_FLAG_RANGE_ACCT_ONLY = 0x2  # ps patch mem-class: the KV/weight ranges label DRAM bytes for PS_DEBUG_CLASS
+                                    # accounting only and do NOT classify requests (hint-only classification)
 
 # DXA descriptor DCR mapping
 # access pattern:
@@ -611,6 +613,30 @@ VX_CSR_CTA_ENTRY = 0xCE1  # kernel entry PC, supplied per-CTA by the KMU
 VX_CSR_FRAG_POS     = 0xCE2  # {covered[31], y[30:16], x[15:0]} of this lane's pixel
 VX_CSR_FRAG_PID     = 0xCE3  # primitive index of this lane's quad
 
+# PhaseShift CSRs (ps patch mem-class). User-level read/write CSRs must sit in the RISC-V custom range
+# 0x800-0x8FF (bits[11:10] = 10, bits[9:8] = 00: user, read/write); 0xC00-0xFFF is read-only by convention. No other
+# VX_CSR_* uses 0x8xx. 0x8C0-0x8C7 is reserved for PhaseShift. Both are per warp / per core state of the ps tree only:
+# the base tree aborts on them (unknown CSR), so kernels write them only when built with -DPS_HINTS=1.
+[csr_ps]
+VX_CSR_PS_MEM_HINT = 0x8C0  # per-warp memory request class (VX_PS_CLASS_*) of the warp's loads/stores; 0 = unset
+VX_CSR_PS_MARK     = 0x8C1  # write: count one work unit of type value&7 (VX_PS_MARK_*) on this core; read: core total
+
+# Memory request classes (MemFlags.mem_class, bits 21-23 of the SimX request flags; docs/methodology.md §12)
+[ps_mem_class]
+VX_PS_CLASS_ORDINARY   = 0  # unclassified (reset value)
+VX_PS_CLASS_WEIGHT     = 1  # weights / parameters
+VX_PS_CLASS_KV_PERSIST = 2  # KV-cache data that is re-read within the launch (e.g. a prefill chunk's keys/values)
+VX_PS_CLASS_KV_STREAM  = 3  # KV-cache data read once per step (decode)
+VX_PS_CLASS_BULK_DXA   = 4  # DXA engine bulk GMEM reads (always, set where DXA builds the request)
+VX_PS_NUM_CLASSES      = 8  # 3-bit field; 5-7 reserved
+
+# ps_mark work-unit types (VX_CSR_PS_MARK)
+[ps_mark_type]
+VX_PS_MARK_OTHER        = 0
+VX_PS_MARK_PREFILL_TILE = 1
+VX_PS_MARK_DECODE_TILE  = 2
+VX_PS_NUM_MARK_TYPES    = 8  # 3-bit type field; 3-7 reserved
+
 [dcr_mpm_class]
 VX_DCR_MPM_CLASS_BASE    = 0
 VX_DCR_MPM_CLASS_CORE    = 1
