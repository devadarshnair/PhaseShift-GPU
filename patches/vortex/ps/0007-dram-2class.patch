+// PhaseShift (patch dram-2class): where do DRAM requests queue? Per channel, sampled once per DRAM clock
+// at the start of Impl::issue() (before the head transaction is offered to Ramulator): the depth of DramSim's own
+// front FIFO `pending_txs` (one entry = one 32 B transaction; a 64 B block is two). ticks = DRAM clocks; busy_ticks =
+// clocks with at least one request of the channel in flight anywhere in the model (inflight > 0), the denominator
+// that ignores idle time; rejects = clocks on which Ramulator refused the head (its read or write buffer was full),
+// accepts = transactions it took. Printed as one PSDRAMQ line per channel by ps_report (PS_DRAM_REPORT=1). Observation
+// only: nothing here is read by the timing model.
+// Percentile of a 1-bucket-per-tick histogram: the smallest w with at least ceil(p * n) samples <= w.
+uint64_t ps_hist_pct(const uint64_t* h, uint32_t nb, uint64_t n, double p) {
+  if (n == 0) return 0;
+  uint64_t need = (uint64_t)(p * (double)n);
+  if ((double)need < p * (double)n) ++need;
+  if (need == 0) need = 1;
+  uint64_t acc = 0;
+  for (uint32_t i = 0; i < nb; ++i) {
+    acc += h[i];
+    if (acc >= need) return i;
+  }
+  return nb - 1;
+}
+
+struct PsFrontQ {
+  uint64_t ticks = 0, busy_ticks = 0, depth_sum = 0, busy_depth_sum = 0, depth_max = 0;
+  uint64_t nonempty_ticks = 0, gt1_ticks = 0, rejects = 0, accepts = 0;
+  // mechanism B at the front (dram_sched != 0): offers of a DEMAND transaction ahead of an older BULK one, and of
+  // the BULK head because its front class wait exceeded W
+  uint64_t demand_first = 0, bulk_aged = 0, bulk_capped = 0;
+};
+
 }
 
