+// Output line of counter k: per-class groups and the mark / DXA groups one line each, the histogram one line per class.
+static uint32_t ps_counter_line(uint32_t k) {
+  if (k < VX_PS_CNT_MARKS) return k / VX_PS_NUM_CLASSES;
+  if (k < VX_PS_CNT_DXA_BYTES) return 100;
+  if (k < VX_PS_CNT_DXA_MAX_INFLIGHT) return 101;
+  if (k < VX_PS_CNT_DRAM_RD_HIST) return 102;
+  return 200 + (k - VX_PS_CNT_DRAM_RD_HIST) / VX_PS_HIST_BUCKETS;
+}
