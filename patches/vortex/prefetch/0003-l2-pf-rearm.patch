+  // PhaseShift (patch l2-pf-rearm): a demand READ joins an in-flight prefetch chain (a LATE prefetch). Stock
+  // the baseline prefetcher (with or without the 32-entry MSHR) treats this as no trigger at all (the filled sector is installed untagged, so no later tagged hit fires
+  // either), so the stream only advances on demand misses and sits ~1 sector ahead of the consumer. Re-arm: treat the
+  // late merge as a stream trigger and queue the sectors that bring the window to P+REARM, where P is the prefetched
+  // sector joined: the last n = max(STEP, REARM-DEPTH) sectors P+REARM-n+1 .. P+REARM (for REARM <= DEPTH: just P+REARM,
+  // for REARM = 16, DEPTH = 8: P+9 .. P+16 so the window stays contiguous). Redundant candidates are dropped at issue
+  // (pf_issue), so re-triggering costs queue slots only. Once per chain (first joiner). PS_PF_REARM=0 = stock.
+  void pf_rearm(uint64_t paddr, uint32_t cls) {
+    if (!pf_on()) return;
+    const pf_cfg_t &c = pf_cfg();
+    if (c.rearm == 0) return;
+    ++pf_st_.rearm_trig;
+    const uint32_t n = std::max<uint32_t>(c.step, c.rearm > c.depth ? c.rearm - c.depth : 0);
+    uint64_t a = paddr;
+    for (uint32_t i = 0; i < c.rearm - n; ++i) a = pf_next(a);   // a = P + (REARM - n)
+    for (uint32_t i = 0; i < n; ++i) {
+      a = pf_next(a);
+      if (pf_q_.size() >= c.qsize) { ++pf_st_.q_drop; break; }
+      pf_q_.push_back({a, uint8_t(cls & (VX_PS_NUM_CLASSES - 1))});
+      ++pf_st_.queued; ++pf_st_.rearm_queued;
+    }
+  }
   void pf_issue() {
