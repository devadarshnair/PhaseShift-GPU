diff --git a/third_party/Makefile b/third_party/Makefile
index a32ff0ff3..991f8e7ba 100644
--- a/third_party/Makefile
+++ b/third_party/Makefile
@@ -1,3 +1,8 @@
+# PhaseShift infra patch 0000 (no simulated-behaviour change): build Ramulator serially and with
+# cmake-4-compatible policy defaults. Override on the make command line if needed.
+RAMULATOR_JOBS ?= 1
+RAMULATOR_CMAKE_FLAGS ?= -DCMAKE_POLICY_VERSION_MINIMUM=3.5
+
 all: cvfpu softfloat ramulator cocogfx
 
 cvfpu:
@@ -6,7 +11,7 @@ softfloat:
 	SPECIALIZE_TYPE=RISCV SOFTFLOAT_OPTS="-fPIC -DSOFTFLOAT_ROUND_ODD -DINLINE_LEVEL=5 -DSOFTFLOAT_FAST_DIV32TO16 -DSOFTFLOAT_FAST_DIV64TO32 -DTHREAD_LOCAL=_Thread_local" $(MAKE) -C softfloat/build/Linux-x86_64-GCC
 
 ramulator/libramulator.so:
-	cd ramulator && mkdir -p build && cd build && cmake .. && make -j4
+	cd ramulator && mkdir -p build && cd build && cmake $(RAMULATOR_CMAKE_FLAGS) .. && $(MAKE) -j$(RAMULATOR_JOBS)
 
 # The GDDR6 device model Ramulator ships but does not build. It registers with
 # Ramulator's factory when the library loads, built as Ramulator builds itself.
