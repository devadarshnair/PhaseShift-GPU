--- /dev/null
+++ b/sim/common/ps_dram_ctrl.cpp
@@ -0,0 +1,596 @@
+// PhaseShift patch dram-2class (semantics, invariants and limits in docs/methodology.md §14.B):
+// the two-class DRAM controller "PsTwoClass" for mechanism B.
+//
+// Built into third_party/ramulator_ext/libramulator-vortex.so next to Ramulator's GDDR6 model (third_party/Makefile),
+// so it registers with Ramulator's factory when the library loads, exactly as that GDDR6 model does; the pinned
+// Ramulator source is not modified. DramSim selects it for every channel (Controller impl "PsTwoClass").
+//
+// Derived from Ramulator 2's GenericDRAMController (third_party/ramulator/src/dram_controller/impl/
+// generic_dram_controller.cpp, MIT License, Copyright (c) 2023 SAFARI Research Group at ETH Zurich and Carnegie Mellon
+// University). With PsDramB::mode == 0 every decision is the Generic controller's: the same buffers, write-mode
+// watermarks, active-buffer-first rule, closing-row check and the configured scheduler (FRFCFS) -- the no-op path.
+// Changes, all marked "PhaseShift":
+//   * the per-source statistics are sized for the 8 request classes that DramSim passes as source_id (Generic sizes
+//     them by the frontend's core count, 1 for the GEM5 frontend, so a class id > 0 would index out of range);
+//   * mode 1/2 replace the scheduler's choice in the read/write buffer by the two-class rule (select_two_class);
+//     the active buffer (requests whose row is already being opened for them) keeps the stock FR-FCFS order in every
+//     mode: those are continuations of requests that were already granted, at most one per bank (methodology §14.B);
+//   * observation-only counters (PsDramB): buffer occupancy, grants per class, the strict-mode invariant counter,
+//     BULK class wait, service times and the per-class controller queue-wait histogram.
+#include <algorithm>
+
+#include "base/base.h"
+#include "dram_controller/controller.h"
+#include "memory_system/memory_system.h"
+
+#include "ps_dram_b.h"
+
+namespace Ramulator {
+
+class PsTwoClassDRAMController final : public IDRAMController, public Implementation {
+  RAMULATOR_REGISTER_IMPLEMENTATION(IDRAMController, PsTwoClassDRAMController, "PsTwoClass",
+                                    "PhaseShift two-class (DEMAND / BULK) DRAM controller (Generic + mechanism B).");
+  private:
+    std::deque<Request> pending;          // A queue for read requests that are about to finish (callback after RL)
+
+    ReqBuffer m_active_buffer;            // Buffer for requests being served. This has the highest priority
+    ReqBuffer m_priority_buffer;          // Buffer for high-priority requests (e.g., maintenance like refresh).
+    ReqBuffer m_read_buffer;              // Read request buffer
+    ReqBuffer m_write_buffer;             // Write request buffer
+
+    int m_bank_addr_idx = -1;
+
+    float m_wr_low_watermark;
+    float m_wr_high_watermark;
+    bool  m_is_write_mode = false;
+
+    size_t s_row_hits = 0;
+    size_t s_row_misses = 0;
+    size_t s_row_conflicts = 0;
+    size_t s_read_row_hits = 0;
+    size_t s_read_row_misses = 0;
+    size_t s_read_row_conflicts = 0;
+    size_t s_write_row_hits = 0;
+    size_t s_write_row_misses = 0;
+    size_t s_write_row_conflicts = 0;
+
+    // PhaseShift: per request class (source_id = VX_PS_CLASS_*, 3 bits) instead of per frontend core.
+    static constexpr size_t kPsSources = 8;
+    size_t m_num_cores = 0;
+    std::vector<size_t> s_read_row_hits_per_core;
+    std::vector<size_t> s_read_row_misses_per_core;
+    std::vector<size_t> s_read_row_conflicts_per_core;
+
+    size_t s_num_read_reqs = 0;
+    size_t s_num_write_reqs = 0;
+    size_t s_num_other_reqs = 0;
+    size_t s_queue_len = 0;
+    size_t s_read_queue_len = 0;
+    size_t s_write_queue_len = 0;
+    size_t s_priority_queue_len = 0;
+    float s_queue_len_avg = 0;
+    float s_read_queue_len_avg = 0;
+    float s_write_queue_len_avg = 0;
+    float s_priority_queue_len_avg = 0;
+
+    size_t s_read_latency = 0;
+    float s_avg_read_latency = 0;
+
+    // PhaseShift: shared state (control + counters), owned by DramSim (ps_dram_b.h).
+    vortex::PsDramB* m_ps = nullptr;
+    vortex::PsDramB  m_ps_local;          // used when no `ps_b` key is given (standalone use)
+    Clk_t m_last_bulk_grant[2] = {0, 0};  // per buffer (0 read, 1 write): clock of the last BULK grant
+
+  public:
+    void init() override {
+      m_wr_low_watermark =  param<float>("wr_low_watermark").desc("Threshold for switching back to read mode.").default_val(0.2f);
+      m_wr_high_watermark = param<float>("wr_high_watermark").desc("Threshold for switching to write mode.").default_val(0.8f);
+      // PhaseShift: address of DramSim's PsDramB for this channel (0 = use a private one, mode 0).
+      uint64_t ps_b = param<uint64_t>("ps_b").desc("PhaseShift: address of the channel's PsDramB.").default_val(0);
+      m_ps = ps_b ? reinterpret_cast<vortex::PsDramB*>(static_cast<uintptr_t>(ps_b)) : &m_ps_local;
+
+      m_scheduler = create_child_ifce<IScheduler>();
+      m_refresh = create_child_ifce<IRefreshManager>();
+      m_rowpolicy = create_child_ifce<IRowPolicy>();
+
+      if (m_config["plugins"]) {
+        YAML::Node plugin_configs = m_config["plugins"];
+        for (YAML::iterator it = plugin_configs.begin(); it != plugin_configs.end(); ++it) {
+          m_plugins.push_back(create_child_ifce<IControllerPlugin>(*it));
+        }
+      }
+    };
+
+    void setup(IFrontEnd* frontend, IMemorySystem* memory_system) override {
+      m_dram = memory_system->get_ifce<IDRAM>();
+      m_bank_addr_idx = m_dram->m_levels("bank");
+      m_priority_buffer.max_size = 512*3 + 32;
+
+      // PhaseShift: one statistics slot per request class (see kPsSources).
+      m_num_cores = std::max<size_t>(frontend->get_num_cores(), kPsSources);
+
+      s_read_row_hits_per_core.resize(m_num_cores, 0);
+      s_read_row_misses_per_core.resize(m_num_cores, 0);
+      s_read_row_conflicts_per_core.resize(m_num_cores, 0);
+
+      register_stat(s_row_hits).name("row_hits_{}", m_channel_id);
+      register_stat(s_row_misses).name("row_misses_{}", m_channel_id);
+      register_stat(s_row_conflicts).name("row_conflicts_{}", m_channel_id);
+      register_stat(s_read_row_hits).name("read_row_hits_{}", m_channel_id);
+      register_stat(s_read_row_misses).name("read_row_misses_{}", m_channel_id);
+      register_stat(s_read_row_conflicts).name("read_row_conflicts_{}", m_channel_id);
+      register_stat(s_write_row_hits).name("write_row_hits_{}", m_channel_id);
+      register_stat(s_write_row_misses).name("write_row_misses_{}", m_channel_id);
+      register_stat(s_write_row_conflicts).name("write_row_conflicts_{}", m_channel_id);
+
+      for (size_t core_id = 0; core_id < m_num_cores; core_id++) {
+        register_stat(s_read_row_hits_per_core[core_id]).name("read_row_hits_core_{}", core_id);
+        register_stat(s_read_row_misses_per_core[core_id]).name("read_row_misses_core_{}", core_id);
+        register_stat(s_read_row_conflicts_per_core[core_id]).name("read_row_conflicts_core_{}", core_id);
+      }
+
+      register_stat(s_num_read_reqs).name("num_read_reqs_{}", m_channel_id);
+      register_stat(s_num_write_reqs).name("num_write_reqs_{}", m_channel_id);
+      register_stat(s_num_other_reqs).name("num_other_reqs_{}", m_channel_id);
+      register_stat(s_queue_len).name("queue_len_{}", m_channel_id);
+      register_stat(s_read_queue_len).name("read_queue_len_{}", m_channel_id);
+      register_stat(s_write_queue_len).name("write_queue_len_{}", m_channel_id);
+      register_stat(s_priority_queue_len).name("priority_queue_len_{}", m_channel_id);
+      register_stat(s_queue_len_avg).name("queue_len_avg_{}", m_channel_id);
+      register_stat(s_read_queue_len_avg).name("read_queue_len_avg_{}", m_channel_id);
+      register_stat(s_write_queue_len_avg).name("write_queue_len_avg_{}", m_channel_id);
+      register_stat(s_priority_queue_len_avg).name("priority_queue_len_avg_{}", m_channel_id);
+
+      register_stat(s_read_latency).name("read_latency_{}", m_channel_id);
+      register_stat(s_avg_read_latency).name("avg_read_latency_{}", m_channel_id);
+    };
+
+    bool send(Request& req) override {
+      req.final_command = m_dram->m_request_translations(req.type_id);
+
+      switch (req.type_id) {
+        case Request::Type::Read: {
+          s_num_read_reqs++;
+          break;
+        }
+        case Request::Type::Write: {
+          s_num_write_reqs++;
+          break;
+        }
+        default: {
+          s_num_other_reqs++;
+          break;
+        }
+      }
+
+      // Forward existing write requests to incoming read requests
+      if (req.type_id == Request::Type::Read) {
+        auto compare_addr = [req](const Request& wreq) {
+          return wreq.addr == req.addr;
+        };
+        if (std::find_if(m_write_buffer.begin(), m_write_buffer.end(), compare_addr) != m_write_buffer.end()) {
+          // The request will depart at the next cycle
+          req.depart = m_clk + 1;
+          pending.push_back(req);
+          return true;
+        }
+      }
+
+      // Else, enqueue them to corresponding buffer based on request type id
+      bool is_success = false;
+      req.arrive = m_clk;
+      if        (req.type_id == Request::Type::Read) {
+        is_success = m_read_buffer.enqueue(req);
+      } else if (req.type_id == Request::Type::Write) {
+        is_success = m_write_buffer.enqueue(req);
+      } else {
+        throw std::runtime_error("Invalid request type!");
+      }
+      if (!is_success) {
+        // We could not enqueue the request
+        req.arrive = -1;
+        return false;
+      }
+
+      return true;
+    };
+
+    bool priority_send(Request& req) override {
+      req.final_command = m_dram->m_request_translations(req.type_id);
+
+      bool is_success = false;
+      is_success = m_priority_buffer.enqueue(req);
+      return is_success;
+    }
+
+    void tick() override {
+      m_clk++;
+
+      // Update statistics
+      s_queue_len += m_read_buffer.size() + m_write_buffer.size() + m_priority_buffer.size() + pending.size();
+      s_read_queue_len += m_read_buffer.size() + pending.size();
+      s_write_queue_len += m_write_buffer.size();
+      s_priority_queue_len += m_priority_buffer.size();
+
+      // PhaseShift: where requests wait inside the controller (observation only).
+      ps_sample_occupancy();
+
+      // 1. Serve completed reads
+      serve_completed_reads();
+
+      m_refresh->tick();
+
+      // 2. Try to find a request to serve.
+      ReqBuffer::iterator req_it;
+      ReqBuffer* buffer = nullptr;
+      bool request_found = schedule_request(req_it, buffer);
+
+      // 2.1 Take row policy action
+      m_rowpolicy->update(request_found, req_it);
+
+      // 3. Update all plugins
+      for (auto plugin : m_plugins) {
+        plugin->update(request_found, req_it);
+      }
+
+      // 4. Finally, issue the commands to serve the request
+      if (request_found) {
+        // If we find a real request to serve
+        if (req_it->is_stat_updated == false) {
+          // PhaseShift: the request's first command = its grant (observation only).
+          ps_on_grant(req_it, buffer);
+          update_request_stats(req_it);
+        }
+        m_dram->issue_command(req_it->command, req_it->addr_vec);
+
+        // If we are issuing the last command, set depart clock cycle and move the request to the pending queue
+        if (req_it->command == req_it->final_command) {
+          ps_on_final(req_it);   // PhaseShift (observation only)
+          if (req_it->type_id == Request::Type::Read) {
+            req_it->depart = m_clk + m_dram->m_read_latency;
+            pending.push_back(*req_it);
+          } else if (req_it->type_id == Request::Type::Write) {
+            // TODO: Add code to update statistics
+          }
+          buffer->remove(req_it);
+        } else {
+          if (m_dram->m_command_meta(req_it->command).is_opening) {
+            m_active_buffer.enqueue(*req_it);
+            buffer->remove(req_it);
+          }
+        }
+
+      } else if (m_ps->mode == 1) {
+        // PhaseShift: cost of non-work-conservation (observation only).
+        if (ps_any_ready(m_read_buffer) || ps_any_ready(m_write_buffer))
+          ++m_ps->strict_idle;
+      }
+
+      // PhaseShift: BULK occupancy after this clock, for DramSim's front admission (bulk_cap).
+      uint32_t nb = 0;
+      for (auto& r : m_read_buffer) nb += ps_is_bulk(r) ? 1 : 0;
+      for (auto& r : m_write_buffer) nb += ps_is_bulk(r) ? 1 : 0;
+      m_ps->bulk_now = nb;
+
+    };
+
+
+  private:
+    // ------------------------------------------------------------------------------------------------------------
+    // PhaseShift: class helpers and counters
+    bool ps_is_bulk(const Request& r) const { return r.source_id == m_ps->bulk_class; }
+    int ps_cls(const Request& r) const { return ps_is_bulk(r) ? 1 : 0; }
+    int ps_buf_idx(const ReqBuffer* b) const { return (b == &m_write_buffer) ? 1 : 0; }
+
+    void ps_sample_occupancy() {
+      auto& s = *m_ps;
+      ++s.ticks;
+      ++s.mode_ticks[s.mode < 3 ? s.mode : 0];
+      if (s.mode != 0 && s.aging > s.aging_max) s.aging_max = s.aging;
+      if (m_read_buffer.size() + m_write_buffer.size() + m_active_buffer.size() > 0) ++s.busy_ticks;
+      s.rdq_occ += m_read_buffer.size();
+      s.wrq_occ += m_write_buffer.size();
+      s.actq_occ += m_active_buffer.size();
+      for (auto& r : m_read_buffer)
+        if (ps_is_bulk(r)) ++s.rdq_occ_bulk;
+    }
+
+    // Oldest BULK request of a buffer (list order = arrival order: send() appends), or end().
+    ReqBuffer::iterator ps_bulk_head(ReqBuffer& b) {
+      for (auto it = b.begin(); it != b.end(); ++it)
+        if (ps_is_bulk(*it)) return it;
+      return b.end();
+    }
+
+    // BULK class wait of buffer b at the current clock: time since the later of the oldest waiting BULK request's
+    // arrival and the buffer's last BULK grant (the time the BULK class has gone unserved). -1 = no BULK waiting.
+    Clk_t ps_bulk_wait(ReqBuffer& b, ReqBuffer::iterator head) const {
+      if (head == b.end()) return -1;
+      return m_clk - std::max(head->arrive, m_last_bulk_grant[ps_buf_idx(&b)]);
+    }
+
+    bool ps_any_ready(ReqBuffer& b) {
+      for (auto& r : b) {
+        int cmd = m_dram->get_preq_command(r.final_command, r.addr_vec);
+        if (m_dram->check_ready(cmd, r.addr_vec)) return true;
+      }
+      return false;
+    }
+
+    void ps_on_grant(ReqBuffer::iterator& req, ReqBuffer* buffer) {
+      req->scratchpad[0] = static_cast<int>(static_cast<uint32_t>(m_clk));   // grant clock (service time)
+      if (buffer != &m_read_buffer && buffer != &m_write_buffer)
+        return;   // priority-buffer (maintenance) requests carry no class
+      auto& s = *m_ps;
+      const int c = ps_cls(*req);
+      ++s.grants[c];
+      if (c != 1)
+        return;
+      bool dwait = false;
+      for (auto it = buffer->begin(); it != buffer->end(); ++it)
+        if (it != req && !ps_is_bulk(*it)) { dwait = true; break; }
+      const Clk_t bw = ps_bulk_wait(*buffer, ps_bulk_head(*buffer));   // >= 0: req itself is BULK
+      if (static_cast<uint64_t>(bw) > s.bwait_max) s.bwait_max = static_cast<uint64_t>(bw);
+      const bool aged = (s.aging > 0) && bw > static_cast<Clk_t>(s.aging);
+      if (aged) ++s.aged_grants;
+      if (dwait) {
+        ++s.bulk_grant_dwait;
+        if (!aged) ++s.viol;
+      }
+      m_last_bulk_grant[ps_buf_idx(buffer)] = m_clk;
+    }
+
+    void ps_on_final(ReqBuffer::iterator& req) {
+      auto& s = *m_ps;
+      const uint64_t svc = static_cast<uint32_t>(static_cast<uint32_t>(m_clk) -
+                                                 static_cast<uint32_t>(req->scratchpad[0]));
+      if (svc > s.svc_max) s.svc_max = svc;
+      if (req->arrive < 0) return;
+      const int c = ps_cls(*req);
+      const uint64_t w = static_cast<uint64_t>(m_clk - req->arrive);
+      ++s.qdone[c];
+      s.qwait_sum[c] += w;
+      if (w > s.qwait_max[c]) s.qwait_max[c] = w;
+      ++s.qwait_hist[c][std::min<uint64_t>(w, vortex::PsDramB::kHist - 1)];
+    }
+
+    // FR-FCFS among the requests of b that satisfy pred (ready first, then oldest) -- FRFCFS::compare restricted to
+    // a class. req.command must be current (set by select_two_class).
+    template <typename P>
+    ReqBuffer::iterator ps_frfcfs(ReqBuffer& b, P pred) {
+      auto best = b.end();
+      bool best_ready = false;
+      for (auto it = b.begin(); it != b.end(); ++it) {
+        if (!pred(*it)) continue;
+        const bool rdy = m_dram->check_ready(it->command, it->addr_vec);
+        if (best == b.end() || (rdy && !best_ready) || (rdy == best_ready && it->arrive < best->arrive)) {
+          best = it;
+          best_ready = rdy;
+        }
+      }
+      return best;
+    }
+
+    // Mechanism B (methodology §14.B): the request of the read or write buffer to work on this clock.
+    //   aged    = W > 0 and the BULK class wait > W: the oldest BULK request (the BULK head) is chosen first;
+    //   mode 1  = otherwise DEMAND (FR-FCFS among DEMAND) whenever any DEMAND waits, BULK only when none does,
+    //             even if the chosen request is not ready this clock (non-work-conserving);
+    //   mode 2  = otherwise the first READY of: DEMAND (FR-FCFS), BULK (FR-FCFS); if nothing is ready, the head if
+    //             aged, else the DEMAND choice, else the BULK choice.
+    ReqBuffer::iterator select_two_class(ReqBuffer& b) {
+      if (b.size() == 0)
+        return b.end();
+      for (auto& req : b)
+        req.command = m_dram->get_preq_command(req.final_command, req.addr_vec);   // as FRFCFS does
+      auto head = ps_bulk_head(b);
+      const Clk_t bw = ps_bulk_wait(b, head);
+      const bool aged = (m_ps->aging > 0) && bw > static_cast<Clk_t>(m_ps->aging);
+      auto is_dem = [this](const Request& r) { return !ps_is_bulk(r); };
+      auto is_blk = [this](const Request& r) { return ps_is_bulk(r); };
+      if (m_ps->mode == 1) {
+        if (aged) return head;
+        auto d = ps_frfcfs(b, is_dem);
+        return (d != b.end()) ? d : ps_frfcfs(b, is_blk);
+      }
+      auto rdy = [this](ReqBuffer::iterator it) { return m_dram->check_ready(it->command, it->addr_vec); };
+      if (aged && rdy(head)) return head;
+      auto d = ps_frfcfs(b, is_dem);
+      if (d != b.end() && rdy(d)) return d;
+      auto k = ps_frfcfs(b, is_blk);
+      if (k != b.end() && rdy(k)) return k;
+      if (aged) return head;
+      return (d != b.end()) ? d : k;
+    }
+    // ------------------------------------------------------------------------------------------------------------
+
+    /**
+     * @brief    Helper function to check if a request is hitting an open row
+     * @details
+     *
+     */
+    bool is_row_hit(ReqBuffer::iterator& req)
+    {
+        return m_dram->check_rowbuffer_hit(req->final_command, req->addr_vec);
+    }
+    /**
+     * @brief    Helper function to check if a request is opening a row
+     * @details
+     *
+    */
+    bool is_row_open(ReqBuffer::iterator& req)
+    {
+        return m_dram->check_node_open(req->final_command, req->addr_vec);
+    }
+
+    /**
+     * @brief
+     * @details
+     *
+     */
+    void update_request_stats(ReqBuffer::iterator& req)
+    {
+      req->is_stat_updated = true;
+
+      // PhaseShift: source_id is the request class; guard the per-source slot like Generic guards -1.
+      const bool src_ok = req->source_id >= 0 && static_cast<size_t>(req->source_id) < m_num_cores;
+      if (req->type_id == Request::Type::Read)
+      {
+        if (is_row_hit(req)) {
+          s_read_row_hits++;
+          s_row_hits++;
+          if (src_ok)
+            s_read_row_hits_per_core[req->source_id]++;
+        } else if (is_row_open(req)) {
+          s_read_row_conflicts++;
+          s_row_conflicts++;
+          if (src_ok)
+            s_read_row_conflicts_per_core[req->source_id]++;
+        } else {
+          s_read_row_misses++;
+          s_row_misses++;
+          if (src_ok)
+            s_read_row_misses_per_core[req->source_id]++;
+        }
+      }
+      else if (req->type_id == Request::Type::Write)
+      {
+        if (is_row_hit(req)) {
+          s_write_row_hits++;
+          s_row_hits++;
+        } else if (is_row_open(req)) {
+          s_write_row_conflicts++;
+          s_row_conflicts++;
+        } else {
+          s_write_row_misses++;
+          s_row_misses++;
+        }
+      }
+    }
+
+    /**
+     * @brief    Helper function to serve the completed read requests
+     * @details
+     * This function is called at the beginning of the tick() function.
+     * It checks the pending queue to see if the top request has received data from DRAM.
+     * If so, it finishes this request by calling its callback and poping it from the pending queue.
+     */
+    void serve_completed_reads() {
+      if (pending.size()) {
+        // Check the first pending request
+        auto& req = pending[0];
+        if (req.depart <= m_clk) {
+          // Request received data from dram
+          if (req.depart - req.arrive > 1) {
+            // Check if this requests accesses the DRAM or is being forwarded.
+            // TODO add the stats back
+            s_read_latency += req.depart - req.arrive;
+          }
+
+          if (req.callback) {
+            // If the request comes from outside (e.g., processor), call its callback
+            req.callback(req);
+          }
+          // Finally, remove this request from the pending queue
+          pending.pop_front();
+        }
+      };
+    };
+
+
+    /**
+     * @brief    Checks if we need to switch to write mode
+     *
+     */
+    void set_write_mode() {
+      if (!m_is_write_mode) {
+        if ((m_write_buffer.size() > m_wr_high_watermark * m_write_buffer.max_size) || m_read_buffer.size() == 0) {
+          m_is_write_mode = true;
+        }
+      } else {
+        if ((m_write_buffer.size() < m_wr_low_watermark * m_write_buffer.max_size) && m_read_buffer.size() != 0) {
+          m_is_write_mode = false;
+        }
+      }
+    };
+
+
+    /**
+     * @brief    Helper function to find a request to schedule from the buffers.
+     *
+     */
+    bool schedule_request(ReqBuffer::iterator& req_it, ReqBuffer*& req_buffer) {
+      bool request_found = false;
+      // 2.1    First, check the act buffer to serve requests that are already activating (avoid useless ACTs)
+      if (req_it= m_scheduler->get_best_request(m_active_buffer); req_it != m_active_buffer.end()) {
+        if (m_dram->check_ready(req_it->command, req_it->addr_vec)) {
+          request_found = true;
+          req_buffer = &m_active_buffer;
+        }
+      }
+
+      // 2.2    If no requests can be scheduled from the act buffer, check the rest of the buffers
+      if (!request_found) {
+        // 2.2.1    We first check the priority buffer to prioritize e.g., maintenance requests
+        if (m_priority_buffer.size() != 0) {
+          req_buffer = &m_priority_buffer;
+          req_it = m_priority_buffer.begin();
+          req_it->command = m_dram->get_preq_command(req_it->final_command, req_it->addr_vec);
+
+          request_found = m_dram->check_ready(req_it->command, req_it->addr_vec);
+          if (!request_found & m_priority_buffer.size() != 0) {
+            return false;
+          }
+        }
+
+        // 2.2.1    If no request to be scheduled in the priority buffer, check the read and write buffers.
+        if (!request_found) {
+          // Query the write policy to decide which buffer to serve
+          set_write_mode();
+          auto& buffer = m_is_write_mode ? m_write_buffer : m_read_buffer;
+          // PhaseShift: mode 0 = the configured scheduler (stock); mode 1/2 = mechanism B's two-class rule.
+          req_it = (m_ps->mode == 0) ? m_scheduler->get_best_request(buffer) : select_two_class(buffer);
+          if (req_it != buffer.end()) {
+            request_found = m_dram->check_ready(req_it->command, req_it->addr_vec);
+            req_buffer = &buffer;
+          }
+        }
+      }
+
+      // 2.3 If we find a request to schedule, we need to check if it will close an opened row in the active buffer.
+      if (request_found) {
+        if (m_dram->m_command_meta(req_it->command).is_closing) {
+          auto& rowgroup = req_it->addr_vec;
+          for (auto _it = m_active_buffer.begin(); _it != m_active_buffer.end(); _it++) {
+            auto& _it_rowgroup = _it->addr_vec;
+            bool is_matching = true;
+            for (int i = 0; i < m_bank_addr_idx + 1 ; i++) {
+              if (_it_rowgroup[i] != rowgroup[i] && _it_rowgroup[i] != -1 && rowgroup[i] != -1) {
+                is_matching = false;
+                break;
+              }
+            }
+            if (is_matching) {
+              request_found = false;
+              break;
+            }
+          }
+        }
+      }
+
+      return request_found;
+    }
+
+    void finalize() override {
+      s_avg_read_latency = (float) s_read_latency / (float) s_num_read_reqs;
+
+      s_queue_len_avg = (float) s_queue_len / (float) m_clk;
+      s_read_queue_len_avg = (float) s_read_queue_len / (float) m_clk;
+      s_write_queue_len_avg = (float) s_write_queue_len / (float) m_clk;
+      s_priority_queue_len_avg = (float) s_priority_queue_len / (float) m_clk;
+
+      return;
+    }
+
+};
+
+}   // namespace Ramulator
