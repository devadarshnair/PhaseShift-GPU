+// PhaseShift (patch a-baselines, docs/methodology.md §14.A.b): UCP-lite [C40], one per cache that is
+// UCP-capable (the L2s), shared by its banks. Two applications: app 0 = A = request class PhaseConfig::ucp_class(),
+// app 1 = B = every other class.
+//  * UMON-DSS: an auxiliary tag directory (ATD) per application on UCP_SAMPLES sampled sets, chosen with the paper's
+//    static rule (set 0 and every 33rd set of the cache; global set index g = bank * sets_per_bank + set). Each ATD
+//    set is a true-LRU stack of up to `ways` line tags; a committed core access of app a to a sampled set increments
+//    hits[a][p] if its tag is at stack position p (0 = MRU), then moves / inserts the tag at MRU (dropping the LRU
+//    tag beyond `ways`). The ATD sees each application as if it had the whole cache.
+//  * Repartition at every epoch boundary start + k*N (N = PhaseConfig::ucp_epoch(); start = the cycle of the first
+//    L2 access with UCP on, so the epoch clock is phase-blind): Lookahead algorithm (paper Algorithm 2) on the hit
+//    counters with each application guaranteed one way, then every counter is halved (paper §3.5).
+//  * Evaluation is lazy (at the next L2 access or fill at or after a boundary, before that access is counted), which
+//    is equivalent to evaluating exactly at the boundary: no access happens in between.
+// Printed (observation only, whenever UCP is on): "PSUCP start", one "PSUCP epoch" line per boundary with the
+// pre-halving counters (the test replays the Lookahead from them) and "PSUCP end" at every flush.
+struct PsUcp {
+  static constexpr uint32_t UCP_SAMPLES = 32, UCP_SAMPLE_STEP = 33;
+  uint32_t ways = 0, sets_per_bank = 0, num_banks = 0;
+  bool active = false;
+  uint64_t start = 0, next = 0, epoch = 0;
+  uint32_t len = 0, cls_a = 0;
+  uint32_t alloc[2] = {0, 0};
+  std::vector<uint64_t> hits[2];
+  uint64_t acc[2] = {0, 0};                       // sampled accesses per app in the current epoch (info only)
+  std::vector<std::vector<uint64_t>> atd[2];      // [sample][stack position] = tag, MRU first
+  // counters over the active period (since start), printed at the end
+  uint64_t fills = 0, fills_a = 0, violations = 0, to_other = 0;
+
+  void init(uint32_t w, uint32_t spb, uint32_t nb) { ways = w; sets_per_bank = spb; num_banks = nb; }
+  void reset() { active = false; }
+  int sample_of(uint32_t bank, uint32_t set) const {
+    const uint64_t g = uint64_t(bank) * sets_per_bank + set;
+    if (g % UCP_SAMPLE_STEP != 0) return -1;
+    const uint64_t k = g / UCP_SAMPLE_STEP;
+    return (k < UCP_SAMPLES) ? int(k) : -1;
+  }
+  uint32_t app_of(uint32_t cls) const { return (cls == cls_a) ? 0u : 1u; }
+  void print_alloc(const char* what, uint64_t cycle) const {
+    std::cout << "PSUCP " << what << " cycle=" << cycle << " start=" << start << " len=" << len << " cls_a=" << cls_a
+              << " ways=" << ways << " alloc=" << alloc[0] << ":" << alloc[1] << std::endl;
+  }
+  // Bring the state up to `cycle` under config `cfg` (called before every UMON access and every UCP fill).
+  void sync(const PhaseConfig& cfg, uint64_t cycle) {
+    if (!cfg.l2_ucp()) {
+      if (active) { this->print_end(cycle, 0, 0); active = false; }
+      return;
+    }
+    if (active && (cfg.ucp_epoch() != len || cfg.ucp_class() != cls_a)) {   // re-parameterised: restart
+      this->print_end(cycle, 0, 0);
+      active = false;
+    }
+    if (!active) {
+      active = true;
+      start = cycle; len = cfg.ucp_epoch(); cls_a = cfg.ucp_class(); next = start + len; epoch = 0;
+      alloc[0] = ways / 2; alloc[1] = ways - ways / 2;   // initial partition: even split (our choice)
+      for (int a = 0; a < 2; ++a) {
+        hits[a].assign(ways, 0);
+        acc[a] = 0;
+        atd[a].assign(UCP_SAMPLES, std::vector<uint64_t>());
+      }
+      fills = fills_a = violations = to_other = 0;
+      this->print_alloc("start", cycle);
+    }
+    while (cycle >= next) {
+      this->repartition(next);
+      next += len;
+    }
+  }
+  void observe(uint32_t bank, uint32_t set, uint64_t tag, uint32_t cls) {
+    const int k = this->sample_of(bank, set);
+    if (k < 0) return;
+    const uint32_t a = this->app_of(cls);
+    auto& st = atd[a][k];
+    ++acc[a];
+    auto it = std::find(st.begin(), st.end(), tag);
+    if (it != st.end()) {
+      ++hits[a][uint32_t(it - st.begin())];
+      st.erase(it);
+    } else if (st.size() >= ways) {
+      st.pop_back();
+    }
+    st.insert(st.begin(), tag);
+  }
+  // U_a(n) - U_a(m): hits app a would gain going from m to n ways (n > m)
+  uint64_t gain(uint32_t a, uint32_t m, uint32_t n) const {
+    uint64_t g = 0;
+    for (uint32_t p = m; p < n && p < ways; ++p) g += hits[a][p];
+    return g;
+  }
+  // Lookahead (paper Algorithm 2) with one way pre-assigned to each application (paper §3.5: at least one way each).
+  // Marginal utility mu = gain / blocks, compared exactly as fractions; for each application the smallest block count
+  // reaching its max mu; the higher max mu wins (tie -> app A, our choice). If neither application has a positive mu
+  // the remaining ways are split evenly, the extra way to A (our choice; the paper leaves blocks_req undefined there).
+  void lookahead(uint32_t out[2]) const {
+    out[0] = 1; out[1] = 1;
+    uint32_t balance = ways - 2;
+    while (balance > 0) {
+      uint64_t bg[2] = {0, 0}; uint32_t bk[2] = {0, 0};
+      for (uint32_t a = 0; a < 2; ++a) {
+        for (uint32_t k = 1; k <= balance; ++k) {
+          const uint64_t g = this->gain(a, out[a], out[a] + k);
+          if (g == 0) continue;
+          if (bk[a] == 0 || g * bk[a] > bg[a] * k) { bg[a] = g; bk[a] = k; }   // strictly larger mu; ties keep the smaller k
+        }
+      }
+      if (bk[0] == 0 && bk[1] == 0) {
+        out[0] += balance - balance / 2;
+        out[1] += balance / 2;
+        break;
+      }
+      uint32_t win;
+      if (bk[1] == 0) win = 0;
+      else if (bk[0] == 0) win = 1;
+      else win = (bg[1] * bk[0] > bg[0] * bk[1]) ? 1 : 0;
+      out[win] += bk[win];
+      balance -= bk[win];
+    }
+  }
+  void repartition(uint64_t boundary) {
+    uint32_t na[2];
+    this->lookahead(na);
+    std::cout << "PSUCP epoch=" << epoch << " cycle=" << boundary << " start=" << start << " len=" << len
+              << " cls_a=" << cls_a << " acc=" << acc[0] << ":" << acc[1] << " hitsA=";
+    for (uint32_t p = 0; p < ways; ++p) std::cout << (p ? "," : "") << hits[0][p];
+    std::cout << " hitsB=";
+    for (uint32_t p = 0; p < ways; ++p) std::cout << (p ? "," : "") << hits[1][p];
+    std::cout << " old=" << alloc[0] << ":" << alloc[1] << " new=" << na[0] << ":" << na[1] << std::endl;
+    alloc[0] = na[0]; alloc[1] = na[1];
+    for (int a = 0; a < 2; ++a) { for (auto& h : hits[a]) h >>= 1; acc[a] = 0; }
+    ++epoch;
+  }
+  // Allowed-victim mask for a new line of class `cls` in a set (paper §3.6 enforcement on top of patch waymask's
+  // masked select_victim): free ways first; else if app a holds fewer lines in the set than its allocation, the
+  // ways held by the other application, else the ways held by a.
+  uint32_t victim_mask(const std::vector<line_t>& lines, uint32_t cls, bool* other) const {
+    const uint32_t a = this->app_of(cls);
+    uint32_t freem = 0, own = 0, oth = 0, n_own = 0;
+    for (uint32_t i = 0; i < lines.size(); ++i) {
+      if (!lines[i].any_valid()) { freem |= 1u << i; continue; }
+      if (this->app_of(lines[i].ps_fill_cls) == a) { own |= 1u << i; ++n_own; }
+      else oth |= 1u << i;
+    }
+    *other = false;
+    if (freem) return freem;
+    if (n_own < alloc[a] && oth) { *other = true; return oth; }
+    return own ? own : oth;
+  }
+  void print_end(uint64_t cycle, uint64_t occ_a, uint64_t valid) const {
+    std::cout << "PSUCP end cycle=" << cycle << " start=" << start << " len=" << len << " cls_a=" << cls_a
+              << " epochs=" << epoch << " alloc=" << alloc[0] << ":" << alloc[1] << " fills=" << fills
+              << " fills_a=" << fills_a << " to_other=" << to_other << " violations=" << violations
+              << " occ_a=" << occ_a << " valid=" << valid << std::endl;
+  }
+};
