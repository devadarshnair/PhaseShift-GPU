@@ -388,9 +388,17 @@ DramSim::~DramSim() {
 
 void DramSim::reset() {
   impl_->reset();
+  // PhaseShift (patch ps-counters): Impl::reset() drops every queued transaction; requests still in flight are no
+  // longer tracked (their PsTrack is released if a late completion arrives, but not counted).
+  ++ps_epoch_;
+  for (auto& n : ps_inflight_) n = 0;
 }
 
 void DramSim::tick() {
+  // PhaseShift (patch ps-counters): occupancy sample at the start of the tick (see PsStats). Observation only.
+  ++ps_cycle_;
+  for (uint32_t c = 0; c < kPsClasses; ++c)
+    ps_stats_.occ[c] += ps_inflight_[c];
   impl_->tick();
 }
 
@@ -398,10 +406,63 @@ bool DramSim::can_accept(uint32_t channel) const {
   return impl_->can_accept(channel);
 }
 
+// PhaseShift (patch ps-counters): the tracking record handed to Impl as the callback argument.
+struct DramSim::PsTrack {
+  DramSim*         owner;
+  ResponseCallback callback;   // the caller's callback and argument, forwarded unchanged
+  void*            arg;
+  uint64_t         sent;       // owner->ps_cycle_ at send_request
+  uint64_t         epoch;
+  uint32_t         cls;
+  bool             is_write;
+};
+
+static uint32_t ps_log2_bucket(uint64_t w) {   // = ps_wait_bucket() in sim/simx/ps_counters.h
+  uint32_t b = 0;
+  while (w > 1 && b < DramSim::kPsHistBuckets - 1) {
+    w >>= 1;
+    ++b;
+  }
+  return b;
+}
+
+bool DramSim::ps_on_response(void* a) {
+  auto t = static_cast<PsTrack*>(a);
+  if (!t->callback(t->arg))
+    return false;   // the caller stalled: same behaviour as without tracking (Impl retries next tick)
+  DramSim* d = t->owner;
+  if (t->epoch == d->ps_epoch_) {
+    const uint64_t w = d->ps_cycle_ - t->sent;
+    const uint32_t c = t->cls;
+    --d->ps_inflight_[c];
+    if (t->is_write) {
+      d->ps_stats_.wr_wait[c] += w;
+      ++d->ps_stats_.wr_done[c];
+    } else {
+      d->ps_stats_.rd_wait[c] += w;
+      ++d->ps_stats_.rd_done[c];
+      ++d->ps_stats_.rd_hist[c][ps_log2_bucket(w)];
+    }
+  }
+  delete t;
+  return true;
+}
+
 void DramSim::send_request(uint32_t channel, uint64_t addr, bool is_write, ResponseCallback callback, void* arg,
                            uint32_t mem_class) {
   // PhaseShift (patch mem-class): count the class; the request itself is timed exactly as before.
   static_assert(kPsClasses == VX_PS_NUM_CLASSES, "DramSim class table must match VX_PS_NUM_CLASSES");
-  ++(is_write ? ps_wr_reqs_ : ps_rd_reqs_)[mem_class & (kPsClasses - 1)];
-  impl_->send_request(channel, addr, is_write, callback, arg);
+  static_assert(kPsHistBuckets == VX_PS_HIST_BUCKETS, "DramSim histogram must match VX_PS_HIST_BUCKETS");
+  const uint32_t cls = mem_class & (kPsClasses - 1);
+  ++(is_write ? ps_wr_reqs_ : ps_rd_reqs_)[cls];
+  if (callback == nullptr) {
+    impl_->send_request(channel, addr, is_write, callback, arg);
+    return;
+  }
+  // PhaseShift (patch ps-counters): track the residency through a forwarding callback (see PsStats). Impl calls
+  // ps_on_response exactly where it would have called `callback`, and ps_on_response returns what `callback` returns,
+  // so the transaction timing and the stall/retry behaviour are unchanged.
+  auto t = new PsTrack{this, callback, arg, ps_cycle_, ps_epoch_, cls, is_write};
+  ++ps_inflight_[cls];
+  impl_->send_request(channel, addr, is_write, &DramSim::ps_on_response, t);
 }
