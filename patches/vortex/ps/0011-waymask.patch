+  static const char* waymask_error(uint32_t word, uint32_t ways) {
+    if (ways > 16) return "way masks support at most 16 ways";
+    const uint32_t all = (1u << ways) - 1u;
+    if ((word & WM_FIELD) & ~all) return "bits 15:0 name a way >= associativity";
+    if ((word >> 16) & ~all) return "bits 31:16 name a way >= associativity";
+    return "";
+  }
