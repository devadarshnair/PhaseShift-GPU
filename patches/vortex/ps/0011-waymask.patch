+  // PhaseShift patch waymask (mechanism A2; semantics in docs/methodology.md §14.A). l1_waymask (L1
+  // dcaches only) and l2_waymask (the L2s only) share one encoding:
+  //   bits 15:0   allowed-victim way mask for every fill whose class is not WEIGHT (0 = all ways)
+  //   bits 31:16  allowed-victim way mask for WEIGHT-class fills (0 = the same mask as bits 15:0)
+  // A mask restricts only which way a fill may evict/occupy (allocation); lookups still search every way, so a line
+  // already resident in a disallowed way still hits (Intel CAT semantics, C42). A mask bit at or above the cache's
+  // associativity is rejected; so is a mask word != 0 together with a non-zero L2 insert policy (D and its baselines
+  // pick victims themselves) or with persist_l2 (lines would survive in ways the next launch's mask forbids). The
+  // mask is a launch-boundary knob: PS_SCHEDULE rejects it (ps_schedule.h), and the flush that ends every launch
+  // empties every way before the next launch's mask is in force.
+  static constexpr uint32_t WM_FIELD = 0xffff;
+  // Effective allowed-way mask for one fill: `word` = l1_waymask or l2_waymask, `ways` = associativity (<= 16).
+  static uint32_t wm_effective(uint32_t word, uint32_t ways, bool weight_fill) {
+    const uint32_t all = (ways >= 32) ? 0xffffffffu : ((1u << ways) - 1u);
+    uint32_t m = word & WM_FIELD;
+    if (weight_fill && (word >> 16) != 0) m = word >> 16;
+    return (m == 0) ? all : (m & all);
+  }
