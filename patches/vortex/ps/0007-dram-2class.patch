+// PhaseShift patch dram-2class (semantics in docs/methodology.md §14.B): the state one DRAM channel's
+// two-class controller (PsTwoClass, ps_dram_ctrl.cpp, built into libramulator-vortex.so) shares with DramSim.
+//
+// DramSim owns one PsDramB per channel and hands its address to the controller through the controller's YAML node
+// (key `ps_b`). DramSim writes the control fields whenever the latched [dcr_phase] config changes (host DCR write or
+// PS_SCHEDULE switch); the controller reads them on every tick and writes the counters. Plain data only: this header
+// is compiled both into SimX/RTL simulators (dram_sim.cpp) and into the Ramulator extension library, so it includes
+// neither Vortex nor Ramulator headers.
+//
+// Classes: the Ramulator request's source_id carries the Vortex request class (VX_PS_CLASS_*, patch mem-class);
+// `bulk_class` (= VX_PS_CLASS_BULK_DXA) is BULK, every other class (and source_id -1, e.g. refresh) is DEMAND.
+#pragma once
+
+#include <cstdint>
+
+namespace vortex {
+
+struct PsDramB {
+  // ---- control (DramSim -> controller) ----
+  // mode: 0 = stock FR-FCFS (bit-identical to Ramulator's Generic controller + FRFCFS scheduler);
+  //       1 = two-class STRICT: a BULK request is never granted while a DEMAND request waits in the same buffer,
+  //           unless the BULK class wait exceeds `aging` (then the oldest BULK request is granted first);
+  //       2 = two-class WORK-CONSERVING: as 1, but a ready BULK request may be granted when no DEMAND request (and
+  //           no aged BULK head) is ready this clock.
+  uint32_t mode = 0;
+  uint32_t aging = 0;        // W in DRAM controller clocks; 0 = no aging (pure class priority)
+  int32_t  bulk_class = 4;   // = VX_PS_CLASS_BULK_DXA (set by DramSim)
+  uint32_t bulk_cap = 8;     // mode != 0: DramSim offers a BULK transaction only while fewer than this many BULK
+                             // requests sit in the read + write buffers (dram_sched bits 15:8, 0 = 8 = 1/4 of 32)
+  // ---- controller state read by DramSim ----
+  uint32_t bulk_now = 0;     // BULK requests in the read + write buffers at the end of the last controller clock
+
+  // ---- counters (controller -> DramSim::ps_report); cumulative since construction, every mode ----
+  static constexpr uint32_t kHist = 4096;   // 1-clock buckets of the controller queue wait; the last one is open
+  uint64_t ticks = 0;
+  uint64_t mode_ticks[3] = {};        // controller clocks spent in each mode (a PS_SCHEDULE may switch inside a launch)
+  uint32_t aging_max = 0;             // largest W in force on any clock with mode != 0
+  uint64_t busy_ticks = 0;            // clocks with a request in the read, write or active buffer
+  uint64_t rdq_occ = 0, rdq_occ_bulk = 0, wrq_occ = 0, actq_occ = 0;   // buffer occupancy summed per tick
+  uint64_t grants[2] = {};            // first commands issued from the read/write buffers, [0] DEMAND, [1] BULK
+  uint64_t bulk_grant_dwait = 0;      // BULK grants while a DEMAND request waited in the same buffer
+  uint64_t viol = 0;                  // ... and the BULK class wait was <= W (or W = 0): the strict-mode invariant
+  uint64_t aged_grants = 0;           // BULK grants with BULK class wait > W (aging fired), W > 0 only
+  uint64_t bwait_max = 0;             // max BULK class wait (clocks) at a BULK grant
+  uint64_t svc_max = 0;               // max service time over all requests: final command clock - first command clock
+  uint64_t strict_idle = 0;           // mode 1 clocks with no issue although some read/write-buffer request was ready
+  uint64_t qdone[2] = {}, qwait_sum[2] = {}, qwait_max[2] = {};   // arrive -> final command, per class
+  uint64_t qwait_hist[2][kHist] = {};
+};
+
+}  // namespace vortex
diff --git a/sim/common/ps_dram_ctrl.cpp b/sim/common/ps_dram_ctrl.cpp
