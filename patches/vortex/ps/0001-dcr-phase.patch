diff --git a/sim/common/phase_config.h b/sim/common/phase_config.h
new file mode 100644
index 000000000..2896b1094
--- /dev/null
+++ b/sim/common/phase_config.h
@@ -0,0 +1,123 @@
+// PhaseShift patch dcr-phase: the latched [dcr_phase] configuration.
+//
+// The host programs the [dcr_phase] DCR block (VX_types.toml, VX_DCR_PHASE_*) between launches. ProcessorImpl,
+// Cluster and Socket decode every write in that range with PhaseConfig::write() and push the latched copy to each
+// consumer: the L1 icache/dcache clusters (socket), the L2 (cluster), the L3 (processor), the DRAM model (DramSim,
+// through Memory) and, when DXA is built, DxaCore. Every consumer keeps its copy in a member that its on_reset()/
+// reset() does NOT touch, because every launch starts with ProcessorImpl::run() -> reset() ->
+// SimPlatform::instance().reset(); the config written before a launch must still be in force after that reset (the
+// same way the DXA descriptor DCRs survive DxaCore::Impl::reset()).
+//
+// Reset value = all zero = "stock Vortex": with every field 0 no consumer may change its behaviour (no-op regression,
+//). This patch only latches and reports the config; the mechanisms that read it come in later patches.
+//
+// Field semantics (encoding only; each mechanism patch documents its meaning in docs/methodology.md §14):
+//   mode          global PhaseShift mode / phase id (0 = off)
+//   flags         bit 0 VX_PHASE_FLAG_PERSIST_L2 (sensitivity knob; never set by default), other bits reserved
+//   l1_waymask    L1 dcache allowed-way mask (0 = all ways, stock)
+//   l2_waymask    L2 allowed-way mask (0 = all ways, stock)
+//   insert_policy L2 insertion policy id for mechanism D (0 = stock)
+//   dxa_depth[c]  DXA in-flight depth limit for request class c = 0..7 (8 bits each; 0 = stock, unlimited)
+//   dram_sched    DRAM scheduler mode for mechanism B (0 = stock)
+//   dram_aging    DRAM aging window in cycles (0 = none)
+//   kv[0], kv[1]  KV-cache address ranges [base, limit) (limit <= base = empty, the reset value)
+//   wgt           weight address range [base, limit)
+// 64-bit addresses are written as LO/HI 32-bit halves (VX_DCR_DATA_BITS = 32).
+#pragma once
+
+#include <VX_types.h>
+#include <cstdint>
+#include <cstdio>
+#include <functional>
+#include <string>
+
+namespace vortex {
+
+struct PhaseConfig {
+  static constexpr uint32_t NUM_CLASSES = 8;
+
+  struct Range {
+    uint64_t base  = 0;
+    uint64_t limit = 0;
+    bool empty() const { return limit <= base; }
+    bool contains(uint64_t addr) const { return addr >= base && addr < limit; }
+  };
+
+  uint32_t mode          = 0;
+  uint32_t flags         = 0;
+  uint32_t l1_waymask    = 0;
+  uint32_t l2_waymask    = 0;
+  uint32_t insert_policy = 0;
+  uint8_t  dxa_depth[NUM_CLASSES] = {};
+  uint32_t dram_sched    = 0;
+  uint32_t dram_aging    = 0;
+  Range    kv[2];
+  Range    wgt;
+
+  bool persist_l2() const { return (flags & VX_PHASE_FLAG_PERSIST_L2) != 0; }
+
+  static bool is_phase_dcr(uint32_t addr) {
+    return addr >= VX_DCR_PHASE_STATE_BEGIN && addr < VX_DCR_PHASE_STATE_END;
+  }
+
+  // Decode one DCR write. Returns false (and changes nothing) for an address outside the block.
+  bool write(uint32_t addr, uint32_t value) {
+    switch (addr) {
+    case VX_DCR_PHASE_MODE:          mode = value; break;
+    case VX_DCR_PHASE_FLAGS:         flags = value; break;
+    case VX_DCR_PHASE_L1_WAYMASK:    l1_waymask = value; break;
+    case VX_DCR_PHASE_L2_WAYMASK:    l2_waymask = value; break;
+    case VX_DCR_PHASE_INSERT_POLICY: insert_policy = value; break;
+    case VX_DCR_PHASE_DXA_DEPTH0:
+    case VX_DCR_PHASE_DXA_DEPTH1: {
+      uint32_t c0 = (addr - VX_DCR_PHASE_DXA_DEPTH0) * 4;
+      for (uint32_t i = 0; i < 4; ++i)
+        dxa_depth[c0 + i] = uint8_t(value >> (8 * i));
+      break;
+    }
+    case VX_DCR_PHASE_DRAM_SCHED:    dram_sched = value; break;
+    case VX_DCR_PHASE_DRAM_AGING:    dram_aging = value; break;
+    case VX_DCR_PHASE_KV0_BASE_LO:   set_lo(kv[0].base, value); break;
+    case VX_DCR_PHASE_KV0_BASE_HI:   set_hi(kv[0].base, value); break;
+    case VX_DCR_PHASE_KV0_LIMIT_LO:  set_lo(kv[0].limit, value); break;
+    case VX_DCR_PHASE_KV0_LIMIT_HI:  set_hi(kv[0].limit, value); break;
+    case VX_DCR_PHASE_KV1_BASE_LO:   set_lo(kv[1].base, value); break;
+    case VX_DCR_PHASE_KV1_BASE_HI:   set_hi(kv[1].base, value); break;
+    case VX_DCR_PHASE_KV1_LIMIT_LO:  set_lo(kv[1].limit, value); break;
+    case VX_DCR_PHASE_KV1_LIMIT_HI:  set_hi(kv[1].limit, value); break;
+    case VX_DCR_PHASE_WGT_BASE_LO:   set_lo(wgt.base, value); break;
+    case VX_DCR_PHASE_WGT_BASE_HI:   set_hi(wgt.base, value); break;
+    case VX_DCR_PHASE_WGT_LIMIT_LO:  set_lo(wgt.limit, value); break;
+    case VX_DCR_PHASE_WGT_LIMIT_HI:  set_hi(wgt.limit, value); break;
+    default: return false;
+    }
+    return true;
+  }
+
+  // Canonical one-line form. kernels/common/ps_phase.h (host helper) prints the same format from the values it
+  // wrote, and tests/test_ps_phase.py compares the two strings exactly.
+  std::string str() const {
+    char buf[1024];
+    snprintf(buf, sizeof(buf),
+             "mode=0x%x flags=0x%x l1_waymask=0x%x l2_waymask=0x%x insert=0x%x"
+             " dxa_depth=%u,%u,%u,%u,%u,%u,%u,%u dram_sched=0x%x dram_aging=%u"
+             " kv0=0x%llx-0x%llx kv1=0x%llx-0x%llx wgt=0x%llx-0x%llx",
+             mode, flags, l1_waymask, l2_waymask, insert_policy,
+             unsigned(dxa_depth[0]), unsigned(dxa_depth[1]), unsigned(dxa_depth[2]), unsigned(dxa_depth[3]),
+             unsigned(dxa_depth[4]), unsigned(dxa_depth[5]), unsigned(dxa_depth[6]), unsigned(dxa_depth[7]),
+             dram_sched, dram_aging,
+             (unsigned long long)kv[0].base, (unsigned long long)kv[0].limit,
+             (unsigned long long)kv[1].base, (unsigned long long)kv[1].limit,
+             (unsigned long long)wgt.base, (unsigned long long)wgt.limit);
+    return buf;
+  }
+
+private:
+  static void set_lo(uint64_t& f, uint32_t v) { f = (f & ~uint64_t(0xffffffffu)) | v; }
+  static void set_hi(uint64_t& f, uint32_t v) { f = (f & uint64_t(0xffffffffu)) | (uint64_t(v) << 32); }
+};
+
+// Visitor over the consumers holding a latched copy: (consumer name, its copy). Used by PS_DUMP_PHASE.
+using PhaseVisitor = std::function<void(const std::string& consumer, const PhaseConfig& cfg)>;
+
+} // namespace vortex
