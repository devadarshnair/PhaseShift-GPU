+// PhaseShift (patch d-baselines, methodology §14.D): SHiP-Mem-lite signature history counter table
+// [C35], one per cache (shared by its banks; a 16 KiB region's lines are interleaved over every bank). Signature =
+// the 16 KiB address region (byte address >> 14), direct-mapped into SHIP_ENTRIES 3-bit saturating counters (no
+// hashing: 16 K entries x 16 KiB = 256 MiB of distinct regions before two regions share a counter, more than any
+// footprint). Counters start at SHIP_INIT = 1 at every launch reset (cold caches, §1; kept in persist_l2 mode like the
+// lines): an untrained region is predicted "re-referenced" and inserts like SRRIP, and one dead eviction is enough to
+// make it distant. Instrumentation (observation only, SHiP-Mem-lite runs only): the first fill that uses an entry
+// prints "PSSHCT first", the first time an entry reaches 0 prints "PSSHCT zero", and every flush (end of a launch)
+// prints "PSSHCT dump" for every entry used in the launch.
+struct PsShct {
+  static constexpr uint32_t SHIP_REGION_BITS = 14, SHIP_ENTRIES = 16384, SHIP_MAX = 7, SHIP_INIT = 1;
+  std::vector<uint8_t> ctr = std::vector<uint8_t>(SHIP_ENTRIES, SHIP_INIT);
+  std::vector<uint8_t> seen = std::vector<uint8_t>(SHIP_ENTRIES, 0);   // bit 0 used, bit 1 has reached 0
+  bool used = false;                                                    // any entry used since the last reset
+  bool dumped = false;                                                  // dumped since the last reset
+  static uint32_t index(uint64_t addr) { return uint32_t(addr >> SHIP_REGION_BITS) & (SHIP_ENTRIES - 1); }
+  void reset() {
+    std::fill(ctr.begin(), ctr.end(), uint8_t(SHIP_INIT));
+    std::fill(seen.begin(), seen.end(), uint8_t(0));
+    used = false;
+    dumped = false;
+  }
+  void use(uint32_t i, uint64_t cycle) {
+    if (!(seen[i] & 1)) {
+      seen[i] |= 1;
+      used = true;
+      std::cout << "PSSHCT first idx=" << i << " cycle=" << cycle << " val=" << uint32_t(ctr[i]) << std::endl;
+    }
+  }
+  void inc(uint32_t i) { if (ctr[i] < SHIP_MAX) ++ctr[i]; }
+  void dec(uint32_t i, uint64_t cycle) {
+    if (ctr[i] > 0) --ctr[i];
+    if (ctr[i] == 0 && !(seen[i] & 2)) {
+      seen[i] |= 2;
+      std::cout << "PSSHCT zero idx=" << i << " cycle=" << cycle << std::endl;
+    }
+  }
+  void dump(uint64_t cycle) const {
+    for (uint32_t i = 0; i < SHIP_ENTRIES; ++i)
+      if (seen[i] & 1)
+        std::cout << "PSSHCT dump idx=" << i << " val=" << uint32_t(ctr[i]) << " cycle=" << cycle << std::endl;
+  }
+};
