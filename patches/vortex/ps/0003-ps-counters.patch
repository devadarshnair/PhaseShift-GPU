+#include <cstring>
+#include <fstream>
+#include <iostream>
+#include <string>
+
+namespace vortex {
+
+static_assert(VX_PS_CNT_DRAM_RD_HIST + VX_PS_NUM_CLASSES * VX_PS_HIST_BUCKETS == VX_PS_CNT_NUM,
+              "[ps_counters] layout: the histogram must be the last group");
+static_assert(VX_PS_CNT_DXA_MAX_INFLIGHT + VX_PS_DXA_STREAMS == VX_PS_CNT_DRAM_RD_HIST, "[ps_counters] layout");
+static_assert(VX_PS_CNT_MARKS + VX_PS_NUM_MARK_TYPES == VX_PS_CNT_DXA_BYTES, "[ps_counters] layout");
+static_assert(VX_DCR_MPM_CLASS_PHASESHIFT < (1u << VX_PS_MPM_PAGE_SHIFT), "MPM class must fit below the page bits");
+static_assert(((VX_PS_CNT_NUM + VX_PS_MPM_PAGE_SIZE - 1) / VX_PS_MPM_PAGE_SIZE) <= (1u << (10 - VX_PS_MPM_PAGE_SHIFT)),
+              "the DCR tag carries 10 MPM class bits: too many pages");
+
+using PsCounters = std::array<uint64_t, VX_PS_CNT_NUM>;
+
+// Short names, shared with perf.cpp (which spells the same tables out; tests/test_pstrace.py compares the two).
+inline const char* ps_class_short(uint32_t c) {
+  static const char* const n[VX_PS_NUM_CLASSES] = {"ord", "wgt", "kvp", "kvs", "dxa", "c5", "c6", "c7"};
+  return n[c & (VX_PS_NUM_CLASSES - 1)];
+}
+inline const char* ps_mark_short(uint32_t t) {
+  static const char* const n[VX_PS_NUM_MARK_TYPES] = {"other", "prefill", "decode", "m3", "m4", "m5", "m6", "m7"};
+  return n[t & (VX_PS_NUM_MARK_TYPES - 1)];
+}
+
+// true for the counters that are maxima (interval value = max within the interval, total = max over the run).
+inline bool ps_counter_is_max(uint32_t k) {
+  return k >= VX_PS_CNT_DXA_MAX_INFLIGHT && k < VX_PS_CNT_DXA_MAX_INFLIGHT + VX_PS_DXA_STREAMS;
+}
+
+inline std::string ps_counter_name(uint32_t k) {
+  struct G { uint32_t base; const char* name; };
+  static const G per_class[] = {
+    {VX_PS_CNT_L1L2_RD_BYTES, "l1l2_rd_bytes"}, {VX_PS_CNT_L1L2_WR_BYTES, "l1l2_wr_bytes"},
+    {VX_PS_CNT_L2_ACCESSES, "l2_acc"}, {VX_PS_CNT_L2_MISSES, "l2_miss"},
+    {VX_PS_CNT_L2_FILLS_DEMOTED, "l2_fill_demoted"}, {VX_PS_CNT_L2_FILLS_BYPASSED, "l2_fill_bypassed"},
+    {VX_PS_CNT_DRAM_RD_BYTES, "dram_rd_bytes"}, {VX_PS_CNT_DRAM_WR_BYTES, "dram_wr_bytes"},
+    {VX_PS_CNT_DRAM_OCC, "dram_occ"}, {VX_PS_CNT_DRAM_BP, "dram_bp"},
+    {VX_PS_CNT_DRAM_RD_WAIT, "dram_rd_wait"}, {VX_PS_CNT_DRAM_RD_DONE, "dram_rd_done"},
+    {VX_PS_CNT_DRAM_WR_WAIT, "dram_wr_wait"}, {VX_PS_CNT_DRAM_WR_DONE, "dram_wr_done"}};
+  for (const auto& g : per_class) {
+    if (k >= g.base && k < g.base + VX_PS_NUM_CLASSES)
+      return std::string(g.name) + "_" + ps_class_short(k - g.base);
+  }
+  if (k >= VX_PS_CNT_MARKS && k < VX_PS_CNT_MARKS + VX_PS_NUM_MARK_TYPES)
+    return std::string("marks_") + ps_mark_short(k - VX_PS_CNT_MARKS);
+  if (k >= VX_PS_CNT_DXA_BYTES && k < VX_PS_CNT_DXA_BYTES + VX_PS_DXA_STREAMS)
+    return "dxa_bytes_s" + std::to_string(k - VX_PS_CNT_DXA_BYTES);
+  if (ps_counter_is_max(k))
+    return "dxa_max_inflight_s" + std::to_string(k - VX_PS_CNT_DXA_MAX_INFLIGHT);
+  if (k >= VX_PS_CNT_DRAM_RD_HIST && k < VX_PS_CNT_NUM) {
+    uint32_t i = k - VX_PS_CNT_DRAM_RD_HIST;
+    return std::string("dram_rd_hist_") + ps_class_short(i / VX_PS_HIST_BUCKETS) + "_b"
+         + std::to_string(i % VX_PS_HIST_BUCKETS);
+  }
+  return "rsvd" + std::to_string(k);
+}
+
+// log2 bucket of a wait in cycles (see VX_PS_HIST_BUCKETS): 0 and 1 -> 0, [2^k, 2^(k+1)) -> k, capped.
+inline uint32_t ps_wait_bucket(uint64_t w) {
+  uint32_t b = 0;
+  while (w > 1 && b < VX_PS_HIST_BUCKETS - 1) {
+    w >>= 1;
+    ++b;
+  }
+  return b;
+}
+
+// Work-unit interval trace (methodology §12.10). The simulator calls:
+//   begin_launch(launch, snap)                   after the launch's reset
+//   due(work) / cross(work, cycle, ticks, instrs, snap)   after every simulated cycle of the launch
+//   end_launch(work, cycle, ticks, instrs, snap)  when the launch is done (before the trailing flush)
+//   flush(cycle, ticks, instrs, snap)             after every cache flush (write-backs, flush ticks)
+// `work` = the per-launch work counter in the trace unit (ps_mark total, or instructions retired since the launch
+// began, summed over cores); `ticks` = cumulative simulated cycles since device open; `instrs` = cumulative retired
+// instructions summed over cores. Row k (1-based) of a launch closes when work first reaches k*n; the LAST row of a
+// launch closes at the end of the launch instead (it also holds the tail after the last unit), so a launch with
+// W > 0 units has exactly ceil(W / n) work rows. Every row holds the counter DELTAS since the previous row (maxima:
+// the maximum within the row), so the sum of all rows of the file equals the end-of-run totals exactly.
+class PsTrace {
+public:
+  enum Unit { MARKS = 0, INSTRS = 1 };
+
+  // Returns nullptr unless PS_TRACE is set; aborts on a bad PS_TRACE_UNIT / PS_TRACE_EVERY.
+  static PsTrace* create_from_env() {
+    const char* path = std::getenv("PS_TRACE");
+    if (path == nullptr || path[0] == '\0')
+      return nullptr;
+    Unit unit = MARKS;
+    if (const char* u = std::getenv("PS_TRACE_UNIT")) {
+      if (std::strcmp(u, "marks") == 0) unit = MARKS;
+      else if (std::strcmp(u, "instrs") == 0) unit = INSTRS;
+      else if (u[0] != '\0') {
+        std::cerr << "Error: PS_TRACE_UNIT must be marks or instrs (got '" << u << "')" << std::endl;
+        std::abort();
+      }
+    }
+    uint64_t every = 1;
+    if (const char* e = std::getenv("PS_TRACE_EVERY")) {
+      char* end = nullptr;
+      unsigned long long v = std::strtoull(e, &end, 10);
+      if (e[0] == '\0' || end == nullptr || *end != '\0' || v == 0) {
+        std::cerr << "Error: PS_TRACE_EVERY must be a positive integer (got '" << e << "')" << std::endl;
+        std::abort();
+      }
+      every = v;
+    }
+    return new PsTrace(path, unit, every);
+  }
+
+  ~PsTrace() { out_.flush(); }
+
+  Unit unit() const { return unit_; }
+
+  void begin_launch(uint64_t launch, const PsCounters& snap) {
+    launch_ = launch;
+    interval_ = 0;
+    next_ = every_;
+    pending_valid_ = false;
+    in_launch_ = true;
+    (void)snap;   // the baseline is the previous row's snapshot (continuous, so nothing is lost between rows)
+  }
+
+  // Per-cycle check (cheap): true when `work` has reached the next boundary. The simulator then takes a snapshot and
+  // calls cross(); several boundaries crossed in one cycle give one row each (the first holds the deltas, the rest
+  // are empty rows closed at the same cycle).
+  bool due(uint64_t work) const { return in_launch_ && work >= next_; }
+  bool in_launch() const { return in_launch_; }
+
+  void cross(uint64_t work, uint64_t cycle, uint64_t ticks, uint64_t instrs, const PsCounters& snap) {
+    while (work >= next_) {
+      Row r = this->close(snap, ticks, instrs);
+      r.kind = "work";
+      r.interval = ++interval_;
+      r.work_end = next_;
+      r.work_at = work;
+      r.cycle = cycle;
+      if (pending_valid_)
+        this->write(pending_);
+      pending_ = r;
+      pending_valid_ = true;
+      next_ += every_;
+    }
+  }
+
+  void end_launch(uint64_t work, uint64_t cycle, uint64_t ticks, uint64_t instrs, const PsCounters& snap) {
+    if (!in_launch_)
+      return;
+    in_launch_ = false;
+    Row tail = this->close(snap, ticks, instrs);
+    if (pending_valid_ && work == pending_.work_end) {
+      // no unit after the last boundary: the tail (epilogue cycles, drain) belongs to the last row
+      this->fold(pending_, tail);
+      pending_.cycle = cycle;
+      this->write(pending_);
+    } else {
+      if (pending_valid_)
+        this->write(pending_);
+      tail.kind = "work";
+      tail.interval = ++interval_;
+      tail.work_end = work;   // partial last interval (or the whole launch when it has fewer than n units)
+      tail.work_at = work;
+      tail.cycle = cycle;
+      this->write(tail);
+    }
+    pending_valid_ = false;
+    last_work_ = work;
+    out_.flush();
+  }
+
+  void flush(uint64_t cycle, uint64_t ticks, uint64_t instrs, const PsCounters& snap) {
+    Row r = this->close(snap, ticks, instrs);
+    r.kind = "flush";
+    r.interval = 0;
+    r.work_end = last_work_;
+    r.work_at = last_work_;
+    r.cycle = cycle;
+    this->write(r);
+    out_.flush();
+  }
+
+private:
+  struct Row {
+    const char* kind = "work";
+    uint64_t interval = 0;
+    uint64_t work_end = 0;
+    uint64_t work_at = 0;
+    uint64_t cycle = 0;
+    uint64_t cycles = 0;
+    uint64_t instrs = 0;
+    PsCounters v{};
+  };
+
+  PsTrace(const char* path, Unit unit, uint64_t every)
+    : out_(path, std::ios::out | std::ios::trunc), unit_(unit), every_(every) {
+    if (!out_) {
+      std::cerr << "Error: cannot open PS_TRACE file " << path << std::endl;
+      std::abort();
+    }
+    base_.fill(0);
+    // header: fixed columns, then every class-8 counter by name (VX_PS_CNT_* order)
+    out_ << "launch,row,kind,interval,unit,every,work_end,work_at,cycle,cycles,instrs";
+    for (uint32_t k = 0; k < VX_PS_CNT_NUM; ++k)
+      out_ << "," << ps_counter_name(k);
+    out_ << "\n";
+  }
+
+  // Row with the deltas since the previous close; advances the baseline. Maxima are taken as is: the simulator
+  // restarts every max window right after each close (ProcessorImpl::ps_trace_closed), so a row's maximum is the
+  // maximum within the row.
+  Row close(const PsCounters& snap, uint64_t ticks, uint64_t instrs) {
+    Row r;
+    for (uint32_t k = 0; k < VX_PS_CNT_NUM; ++k)
+      r.v[k] = ps_counter_is_max(k) ? snap[k] : snap[k] - base_[k];
+    r.cycles = ticks - base_ticks_;
+    r.instrs = instrs - base_instrs_;
+    base_ = snap;
+    base_ticks_ = ticks;
+    base_instrs_ = instrs;
+    return r;
+  }
+
+  static void fold(Row& into, const Row& tail) {
+    for (uint32_t k = 0; k < VX_PS_CNT_NUM; ++k)
+      into.v[k] = ps_counter_is_max(k) ? std::max(into.v[k], tail.v[k]) : into.v[k] + tail.v[k];
+    into.cycles += tail.cycles;
+    into.instrs += tail.instrs;
+  }
+
+  void write(const Row& r) {
+    out_ << launch_ << "," << row_++ << "," << r.kind << "," << r.interval << ","
+         << (unit_ == MARKS ? "marks" : "instrs") << "," << every_ << "," << r.work_end << "," << r.work_at << ","
+         << r.cycle << "," << r.cycles << "," << r.instrs;
+    for (uint32_t k = 0; k < VX_PS_CNT_NUM; ++k)
+      out_ << "," << r.v[k];
+    out_ << "\n";
+  }
+
+private:
+  std::ofstream out_;
+  Unit     unit_;
+  uint64_t every_;
+  uint64_t launch_ = 0;
+  uint64_t row_ = 0;
+  uint64_t interval_ = 0;
+  uint64_t next_ = 0;
+  uint64_t last_work_ = 0;
+  bool     in_launch_ = false;
+  bool     pending_valid_ = false;
+  Row      pending_;
+  PsCounters base_{};
+  uint64_t base_ticks_ = 0;
+  uint64_t base_instrs_ = 0;
+};
+
+}  // namespace vortex
