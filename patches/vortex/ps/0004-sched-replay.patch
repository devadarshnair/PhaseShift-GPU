new file mode 100644
index 000000000..b2e158d1e
--- /dev/null
+++ b/sim/simx/ps_schedule.h
@@ -0,0 +1,238 @@
+// PhaseShift patch sched-replay (format and rules: docs/methodology.md §5.1).
+//
+// Work-unit schedule replay: PS_SCHEDULE=<file> makes SimX switch the latched [dcr_phase] PhaseConfig inside a launch
+// whenever the per-launch work counter (the trace unit: ps_mark total or retired instructions since the launch
+// began, summed over cores) reaches the work_count of a schedule line. This makes a DP-oracle sub-kernel schedule
+// executable.
+//
+// File format (one switch per line; '#' starts a comment; blank lines ignored):
+//     [launch=<k>] <work_count> <knob>=<value> [<knob>=<value> ...]
+//   launch=<k>   optional: the line applies only to launch k (0-based launch index since device open); a line
+//                without it applies to every launch
+//   work_count   decimal; 0 = at the start of the launch (before its first cycle)
+//   value        decimal or 0x-hex (strtoull base 0)
+// Lines must be in non-decreasing work_count order (checked). Knobs (PhaseConfig fields; policy-only knobs and the
+// classification ranges): mode, insert, dxa_depth0..dxa_depth7, dram_sched, dram_aging, kv0_base, kv0_limit,
+// kv1_base, kv1_limit, wgt_base, wgt_limit, range_acct_only (0/1). Rejected (the parser aborts): l1_waymask and
+// l2_waymask (mechanism A2: a way-mask change needs a flush), lmem / kmu_lmem (A1: needs a kernel boundary),
+// persist_l2 and flags (launch-boundary knob, sensitivity study only), any unknown knob.
+//
+// Semantics: at the start of every launch the effective config is the host-written (DCR-latched) config; then the
+// launch's lines are applied in file order, each one on top of the previous effective config (a line changes only
+// the knobs it names). A line with work_count W > 0 takes effect after the first simulated cycle at which work >= W
+// (several lines crossed in one cycle are applied in order, in that cycle). At the end of a launch (before its
+// trailing flush) the host config is pushed back, so host DCR writes between launches see a clean latch.
+// The unit is PS_SCHEDULE_UNIT=marks|instrs (default: PS_TRACE_UNIT if set, else marks). Every switch prints one line
+// "PSSCHED launch=<k> line=<n> work_count=<W> work=<w> cycle=<c> <PhaseConfig::str()>" (stdout; observation only).
+#pragma once
+
+#include "phase_config.h"
+#include <cerrno>
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+#include <fstream>
+#include <iostream>
+#include <sstream>
+#include <string>
+#include <vector>
+
+namespace vortex {
+
+class PsSchedule {
+public:
+  enum Unit { MARKS = 0, INSTRS = 1 };
+
+  struct Set {
+    enum Knob { MODE, INSERT, DXA_DEPTH, DRAM_SCHED, DRAM_AGING, KV_BASE, KV_LIMIT, WGT_BASE, WGT_LIMIT, RANGE_ACCT };
+    Knob     knob;
+    uint32_t idx;     // dxa_depth class / kv range index
+    uint64_t value;
+  };
+  struct Line {
+    uint32_t         lineno = 0;
+    bool             any_launch = true;
+    uint64_t         launch = 0;
+    uint64_t         work = 0;
+    std::vector<Set> sets;
+  };
+
+  // Returns nullptr unless PS_SCHEDULE is set; aborts on any format error.
+  static PsSchedule* create_from_env() {
+    const char* path = std::getenv("PS_SCHEDULE");
+    if (path == nullptr || path[0] == '\0')
+      return nullptr;
+    Unit unit = MARKS;
+    const char* u = std::getenv("PS_SCHEDULE_UNIT");
+    if (u == nullptr || u[0] == '\0')
+      u = std::getenv("PS_TRACE_UNIT");
+    if (u != nullptr && u[0] != '\0') {
+      if (std::strcmp(u, "marks") == 0) unit = MARKS;
+      else if (std::strcmp(u, "instrs") == 0) unit = INSTRS;
+      else fail(path, 0, std::string("PS_SCHEDULE_UNIT must be marks or instrs (got '") + u + "')");
+    }
+    auto* s = new PsSchedule(unit);
+    s->parse(path);
+    return s;
+  }
+
+  Unit unit() const { return unit_; }
+  size_t size() const { return lines_.size(); }
+
+  // Start of launch `launch`: select its lines; returns the effective config after the work_count-0 lines.
+  PhaseConfig begin_launch(uint64_t launch, const PhaseConfig& host) {
+    launch_ = launch;
+    active_.clear();
+    for (size_t i = 0; i < lines_.size(); ++i)
+      if (lines_[i].any_launch || lines_[i].launch == launch)
+        active_.push_back(i);
+    next_ = 0;
+    eff_ = host;
+    in_launch_ = true;
+    this->apply_due(0, 0);
+    return eff_;
+  }
+  bool in_launch() const { return in_launch_; }
+  void end_launch() { in_launch_ = false; }
+  bool modified() const { return modified_; }
+  void clear_modified() { modified_ = false; }
+
+  // Per-cycle check (cheap).
+  bool due(uint64_t work) const { return in_launch_ && next_ < active_.size() && work >= lines_[active_[next_]].work; }
+
+  // Apply every line with work_count <= work; returns the new effective config.
+  const PhaseConfig& apply_due(uint64_t work, uint64_t cycle) {
+    while (next_ < active_.size() && work >= lines_[active_[next_]].work) {
+      const Line& l = lines_[active_[next_]];
+      for (const auto& st : l.sets)
+        set(eff_, st);
+      modified_ = true;
+      std::cout << "PSSCHED launch=" << launch_ << " line=" << l.lineno << " work_count=" << l.work << " work=" << work
+                << " cycle=" << cycle << " " << eff_.str() << std::endl;
+      ++next_;
+    }
+    return eff_;
+  }
+
+private:
+  explicit PsSchedule(Unit unit) : unit_(unit) {}
+
+  [[noreturn]] static void fail(const char* path, uint32_t lineno, const std::string& msg) {
+    std::cerr << "Error: PS_SCHEDULE " << path << ":" << lineno << ": " << msg << std::endl;
+    std::abort();
+  }
+
+  static bool to_u64(const std::string& t, uint64_t* v) {
+    if (t.empty() || t[0] == '-' || t[0] == '+')
+      return false;
+    errno = 0;
+    char* end = nullptr;
+    unsigned long long x = std::strtoull(t.c_str(), &end, 0);
+    if (errno != 0 || end == nullptr || *end != '\0')
+      return false;
+    *v = x;
+    return true;
+  }
+
+  static void set(PhaseConfig& c, const Set& s) {
+    switch (s.knob) {
+    case Set::MODE:       c.mode = uint32_t(s.value); break;
+    case Set::INSERT:     c.insert_policy = uint32_t(s.value); break;
+    case Set::DXA_DEPTH:  c.dxa_depth[s.idx] = uint8_t(s.value); break;
+    case Set::DRAM_SCHED: c.dram_sched = uint32_t(s.value); break;
+    case Set::DRAM_AGING: c.dram_aging = uint32_t(s.value); break;
+    case Set::KV_BASE:    c.kv[s.idx].base = s.value; break;
+    case Set::KV_LIMIT:   c.kv[s.idx].limit = s.value; break;
+    case Set::WGT_BASE:   c.wgt.base = s.value; break;
+    case Set::WGT_LIMIT:  c.wgt.limit = s.value; break;
+    case Set::RANGE_ACCT:
+      c.flags = s.value ? (c.flags | VX_PHASE_FLAG_RANGE_ACCT_ONLY) : (c.flags & ~uint32_t(VX_PHASE_FLAG_RANGE_ACCT_ONLY));
+      break;
+    }
+  }
+
+  void parse(const char* path) {
+    std::ifstream in(path);
+    if (!in)
+      fail(path, 0, "cannot open");
+    std::string text;
+    uint32_t lineno = 0;
+    uint64_t last_work = 0;
+    while (std::getline(in, text)) {
+      ++lineno;
+      auto hash = text.find('#');
+      if (hash != std::string::npos)
+        text.resize(hash);
+      std::istringstream ss(text);
+      std::vector<std::string> tok;
+      for (std::string t; ss >> t;)
+        tok.push_back(t);
+      if (tok.empty())
+        continue;
+      Line l;
+      l.lineno = lineno;
+      size_t i = 0;
+      if (tok[0].rfind("launch=", 0) == 0) {
+        if (!to_u64(tok[0].substr(7), &l.launch))
+          fail(path, lineno, "bad launch selector '" + tok[0] + "'");
+        l.any_launch = false;
+        ++i;
+      }
+      if (i >= tok.size() || !to_u64(tok[i], &l.work))
+        fail(path, lineno, "expected a work_count (non-negative integer)");
+      ++i;
+      if (l.work < last_work)
+        fail(path, lineno, "work_count decreases (lines must be in non-decreasing work_count order)");
+      last_work = l.work;
+      if (i >= tok.size())
+        fail(path, lineno, "a line needs at least one knob=value");
+      for (; i < tok.size(); ++i) {
+        auto eq = tok[i].find('=');
+        if (eq == std::string::npos || eq == 0)
+          fail(path, lineno, "expected knob=value, got '" + tok[i] + "'");
+        std::string k = tok[i].substr(0, eq);
+        Set s{Set::MODE, 0, 0};
+        if (!to_u64(tok[i].substr(eq + 1), &s.value))
+          fail(path, lineno, "bad value in '" + tok[i] + "'");
+        uint64_t max = 0xffffffffull;
+        if (k == "l1_waymask" || k == "l2_waymask")
+          fail(path, lineno, "'" + k + "' rejected: a way-mask change (A2) needs a flush, not a schedule switch");
+        else if (k == "lmem" || k == "kmu_lmem")
+          fail(path, lineno, "'" + k + "' rejected: an LMEM change (A1) needs a kernel boundary");
+        else if (k == "persist_l2" || k == "flags")
+          fail(path, lineno, "'" + k + "' rejected: persist_l2 is a launch-boundary sensitivity knob, never scheduled");
+        else if (k == "mode") s.knob = Set::MODE;
+        else if (k == "insert") s.knob = Set::INSERT;
+        else if (k.rfind("dxa_depth", 0) == 0 && k.size() == 10 && k[9] >= '0' && k[9] <= '7') {
+          s.knob = Set::DXA_DEPTH; s.idx = uint32_t(k[9] - '0'); max = 0xff;
+        }
+        else if (k == "dram_sched") s.knob = Set::DRAM_SCHED;
+        else if (k == "dram_aging") s.knob = Set::DRAM_AGING;
+        else if (k == "kv0_base" || k == "kv1_base") { s.knob = Set::KV_BASE; s.idx = uint32_t(k[2] - '0'); max = ~0ull; }
+        else if (k == "kv0_limit" || k == "kv1_limit") { s.knob = Set::KV_LIMIT; s.idx = uint32_t(k[2] - '0'); max = ~0ull; }
+        else if (k == "wgt_base") { s.knob = Set::WGT_BASE; max = ~0ull; }
+        else if (k == "wgt_limit") { s.knob = Set::WGT_LIMIT; max = ~0ull; }
+        else if (k == "range_acct_only") { s.knob = Set::RANGE_ACCT; max = 1; }
+        else
+          fail(path, lineno, "unknown knob '" + k + "'");
+        if (s.value > max)
+          fail(path, lineno, "value out of range in '" + tok[i] + "'");
+        l.sets.push_back(s);
+      }
+      lines_.push_back(l);
+    }
+    if (lines_.empty())
+      fail(path, lineno, "no schedule lines");
+  }
+
+  Unit                 unit_;
+  std::vector<Line>    lines_;
+  std::vector<size_t>  active_;
+  size_t               next_ = 0;
+  uint64_t             launch_ = 0;
+  bool                 in_launch_ = false;
+  bool                 modified_ = false;
+  PhaseConfig          eff_;
+};
+
+} // namespace vortex
