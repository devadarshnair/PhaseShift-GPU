+// PhaseShift (patch waymask, mechanism A2; methodology §14.A): reject an illegal way-mask config before a
+// launch (host config) or at a schedule switch (effective config). Checked here, on the whole config, and not per DCR
+// write, because the host writes the block register by register and an intermediate state may mix old and new fields.
+void ProcessorImpl::ps_waymask_check(const PhaseConfig& cfg, const char* where) const {
+  auto fail = [&](const char* what, uint32_t v, const char* why) {
+    std::cerr << "Error: [dcr_phase] " << what << "=0x" << std::hex << v << std::dec << " rejected (" << where
+              << "): " << why << std::endl;
+    std::abort();
+  };
+  if (cfg.l1_waymask == 0 && cfg.l2_waymask == 0)
+    return;
+  const char* err = PhaseConfig::waymask_error(cfg.l1_waymask, VX_CFG_DCACHE_NUM_WAYS);
+  if (err[0] != 0) fail("l1_waymask", cfg.l1_waymask, err);
+  err = PhaseConfig::waymask_error(cfg.l2_waymask, VX_CFG_L2_NUM_WAYS);
+  if (err[0] != 0) fail("l2_waymask", cfg.l2_waymask, err);
+  if (cfg.l1_waymask != 0 && !VX_CFG_DCACHE_ENABLED) fail("l1_waymask", cfg.l1_waymask, "the L1 dcache is disabled");
+  if (cfg.l2_waymask != 0 && !VX_CFG_L2_ENABLED) fail("l2_waymask", cfg.l2_waymask, "the L2 is disabled");
+  if (cfg.l2_waymask != 0 && cfg.insert_policy != 0)
+    fail("l2_waymask", cfg.l2_waymask, "exclusive with a non-zero L2 insert policy (mechanism D and its baselines)");
+  if (cfg.persist_l2())
+    fail(cfg.l2_waymask ? "l2_waymask" : "l1_waymask", cfg.l2_waymask ? cfg.l2_waymask : cfg.l1_waymask,
+         "exclusive with persist_l2 (lines would outlive the mask)");
+}
+
+void ProcessorImpl::ps_waymask_report() const {
+  PsClassCollect col;
+  for (auto& cluster : clusters_)
+    cluster->ps_collect(col);
+  const uint64_t launch = phase_launches_ ? phase_launches_ - 1 : 0;
+  const std::pair<const char*, const Cache::PsClassStats*> levels[] = {{"l1d", &col.l1d}, {"l2", &col.l2}};
+  for (auto& lv : levels) {
+    const uint32_t word = (lv.second == &col.l1d) ? phase_cfg_.l1_waymask : phase_cfg_.l2_waymask;
+    std::cout << "PSWAYMASK launch=" << launch << " level=" << lv.first << std::hex << " word=0x" << word
+              << " ways_used=0x" << lv.second->wm_ways_used << std::dec << " fills=" << lv.second->wm_fills
+              << " fills_wgt=" << lv.second->wm_fills_wgt << " violations=" << lv.second->wm_violations
+              << " reqs=" << [&] { std::string o; for (uint32_t c = 0; c < VX_PS_NUM_CLASSES; ++c) { if (c) o += ","; o += std::to_string(lv.second->reqs[c]); } return o; }()
+              << " misses=" << [&] { std::string o; for (uint32_t c = 0; c < VX_PS_NUM_CLASSES; ++c) { if (c) o += ","; o += std::to_string(lv.second->misses[c]); } return o; }()
+              << std::endl;
+  }
+}
