   // AMO admission defer) must consult this mirror as well.
   std::vector<std::pair<uint32_t, uint64_t>> pipe_core_lines_;
 
+  // PhaseShift (patch cache-ordering, errata 38)
+  // Ordering of same-sector accesses inside the bank. See errata 38 and results/<run>/README.md.
+  // ord_pipe_ mirrors pipe_req_ (one entry per request, pushed and popped with it). ord_live_ is the order checker's
+  // record of admitted-but-unperformed accesses per sector (only with PS_ORDER_CHECK=1).
+  struct ord_ent_t {
+    uint64_t key;      // sector address
+    uint64_t seq;      // adm_seq
+    uint64_t byteen;
+    uint8_t  type;     // bank_req_t::ReqType
+    bool     wr;       // plain store
+    bool     amo;      // atomic
+  };
+  std::deque<ord_ent_t> ord_pipe_;
+  std::unordered_map<uint64_t, std::vector<ord_ent_t>> ord_live_;
+  uint64_t ord_holds_ = 0, ord_fwd_blocks_ = 0, ord_checks_ = 0, ord_viol_ = 0, ord_printed_ = 0;
+  static bool ord_fix_on() {
+    return true;
+  }
+  static bool ord_check_on() {
+    static int v = -1;
+    if (v < 0) { const char* e = std::getenv("PS_ORDER_CHECK"); v = (e && e[0] && std::strcmp(e, "0") != 0) ? 1 : 0; }
+    return v == 1;
+  }
+  uint64_t ord_key(uint64_t addr) const {
+    return params_.mem_addr_sector(bank_id_, params_.addr_set_id(addr), params_.addr_tag(addr), params_.addr_sector_id(addr));
+  }
+  ord_ent_t ord_ent(const bank_req_t &r) const {
+    ord_ent_t e;
+    e.key = this->ord_key(r.addr);
+    e.seq = r.adm_seq;
+    e.byteen = r.byteen;
+    e.type = uint8_t(r.type);
+    e.wr = r.write;
+    e.amo = memop_is_atomic(r.op) || (r.type == bank_req_t::AmoProbe);
+    return e;
+  }
+  // Two same-sector accesses must perform in admission order iff this is true (see the file header of
+  // results/<run>/instr/apply_fix.py): any atomic; never two loads; two stores only if their bytes overlap (a zero
+  // byteen counts as the whole sector); a load and a store always (a load's footprint is the sector).
+  static bool ord_conflict(const ord_ent_t &a, const ord_ent_t &b) {
+    if (a.amo || b.amo) return true;
+    if (!a.wr && !b.wr) return false;
+    if (a.wr && b.wr) return (a.byteen == 0 || b.byteen == 0 || (a.byteen & b.byteen) != 0);
+    return true;
+  }
+  void pipe_push(const bank_req_t &r) {
+    pipe_req_->push(r);
+    ord_pipe_.push_back(this->ord_ent(r));
+    if (ord_pipe_.size() != pipe_req_->size()) {
+      std::cerr << "PSORDER fatal: pipe mirror out of sync in " << this->name() << std::endl;
+      std::abort();
+    }
+    if ((r.type == bank_req_t::Core || r.type == bank_req_t::AmoProbe) && ord_check_on())
+      this->ord_admit(r);
+  }
+  void pipe_pop() {
+    if (ord_pipe_.empty()) {
+      std::cerr << "PSORDER fatal: pipe mirror underflow in " << this->name() << std::endl;
+      std::abort();
+    }
+    ord_pipe_.pop_front();
+    pipe_req_->pop();
+  }
+  // Gate G: true if the oldest ready replay must not enter the pipe this tick.
+  bool ord_replay_held() const {
+    if (!ord_fix_on()) return false;
+    const auto *h = mshr_.peek_next_replay();
+    if (h == nullptr) return false;
+    const ord_ent_t he = this->ord_ent(h->bank_req);
+    for (const auto &e : ord_pipe_) {
+      if ((e.type == bank_req_t::Core || e.type == bank_req_t::AmoProbe) && e.key == he.key && ord_conflict(e, he))
+        return true;
+    }
+    return false;
+  }
+  // Gate F: true if the chain head must not be forwarded this tick.
+  bool ord_forward_blocked(const bank_req_t &h) const {
+    if (!ord_fix_on()) return false;
+    const ord_ent_t he = this->ord_ent(h);
+    for (const auto &e : ord_pipe_) {
+      if (e.type != bank_req_t::Fill && e.key == he.key && e.seq < he.seq && ord_conflict(e, he))
+        return true;
+    }
+    return false;
+  }
+  // ---- order checker (PS_ORDER_CHECK=1; read-only) ----
+  void ord_admit(const bank_req_t &r) {
+    const ord_ent_t e = this->ord_ent(r);
+    ord_live_[e.key].push_back(e);
+  }
+  void ord_perform(const bank_req_t &r, const char* where) {
+    if (!ord_check_on()) return;
+    const ord_ent_t a = this->ord_ent(r);
+    auto it = ord_live_.find(a.key);
+    if (it == ord_live_.end()) return;   // admitted before the checker saw it (cannot happen after a reset)
+    auto &v = it->second;
+    ++ord_checks_;
+    for (const auto &b : v) {
+      if (b.seq < a.seq && ord_conflict(a, b)) {
+        ++ord_viol_;
+        if (ord_printed_ < 20) {
+          ++ord_printed_;
+          std::cout << "PSORDER violation bank=" << this->name() << " at=" << where << " sector=0x" << std::hex << a.key
+                    << std::dec << " perform_seq=" << a.seq << " kind=" << (a.amo ? "amo" : (a.wr ? "st" : "ld"))
+                    << " older_unperformed_seq=" << b.seq << " kind=" << (b.amo ? "amo" : (b.wr ? "st" : "ld"))
+                    << " cycle=" << SimPlatform::instance().cycles() << std::endl;
+        }
+        break;
+      }
+    }
+    for (auto i = v.begin(); i != v.end(); ++i) {
+      if (i->seq == a.seq) { v.erase(i); break; }
+    }
+    if (v.empty()) ord_live_.erase(it);
+  }
+  void ord_summary(const char* when) {
+    if (!ord_check_on() || (ord_checks_ == 0 && ord_holds_ == 0 && ord_fwd_blocks_ == 0)) return;
+    uint64_t live = 0;
+    for (const auto &kv : ord_live_) live += kv.second.size();
+    std::cout << "PSORDER bank=" << this->name() << " when=" << when << " checks=" << ord_checks_
+              << " violations=" << ord_viol_ << " holds=" << ord_holds_ << " fwd_blocks=" << ord_fwd_blocks_
+              << " live=" << live << std::endl;
+  }
