diff --git a/sw/common/dxa_meta.h b/sw/common/dxa_meta.h
index 7dbc16b84..078ddf0ea 100644
--- a/sw/common/dxa_meta.h
+++ b/sw/common/dxa_meta.h
@@ -31,3 +31,18 @@
 #define DXA_DESC_META_SWIZZLE_LSB    (DXA_DESC_META_LAYOUT_LSB + DXA_DESC_META_LAYOUT_BITS)
 #define DXA_DESC_META_INTERLEAVE_LSB (DXA_DESC_META_SWIZZLE_LSB + DXA_DESC_META_SWIZZLE_BITS)
 #define DXA_DESC_META_L2PROMO_LSB    (DXA_DESC_META_INTERLEAVE_LSB + DXA_DESC_META_INTERLEAVE_BITS)
+
+// PhaseShift (patch dxa-class, docs/methodology.md §14.C): per-stream fields in META bits that the stock
+// encoder never sets. The stock fields above occupy bits 0..12 (DXA_DESC_META_TOTAL_BITS = 13 in VX_dxa_pkg.sv); the
+// META DCR word is 32 bits wide (VX_DCR_DATA_BITS). Neither the RTL (VX_dxa_setup.sv reads only DIM, ELEMSZ and
+// LAYOUT) nor stock SimX reads bits 13..31, so a descriptor with these bits clear behaves exactly as before.
+//   bits 15:13  PS_CLASS   request class (VX_PS_CLASS_*) carried by every GMEM read of the stream; 0 = unset, which
+//                          keeps the stock tag BULK_DXA (so a stream cannot be tagged ORDINARY on purpose)
+//   bit  16     PS_L2ONLY  L2-prefetch-only: the GMEM reads are issued (and fill the L2), the responses are dropped
+//                          at the DXA, no LMEM byte is written; the barrier is released when the last read returns
+//   bits 31:17  reserved (ignored, as before)
+// SimX only: the RTL ignores these bits (the class tag is simulation-only, like every PhaseShift class mechanism).
+#define DXA_DESC_META_PS_CLASS_LSB   13
+#define DXA_DESC_META_PS_CLASS_BITS  3
+#define DXA_DESC_META_PS_L2ONLY_LSB  16
+#define DXA_DESC_META_PS_L2ONLY_BITS 1
diff --git a/sw/runtime/include/dxa.h b/sw/runtime/include/dxa.h
index 6f0a3f426..214f119a9 100644
--- a/sw/runtime/include/dxa.h
+++ b/sw/runtime/include/dxa.h
@@ -297,6 +297,23 @@ inline int set_tile_geometry(
                       (blk_k << 16) | (tcN & 0xffffu));
 }
 
+// PhaseShift (patch dxa-class, docs/methodology.md §14.C): rewrite META with the per-stream class
+// (VX_PS_CLASS_*, 0 = unset = the stock BULK_DXA tag) and the L2-prefetch-only bit (dxa_meta.h, bits 13..16). As
+// set_layout, META is re-packed from scratch: call AFTER program_Nd (and instead of a later set_layout), passing the
+// same rank, elem_bytes and layout. SimX only (the RTL ignores bits 13..31).
+inline int ps_set_stream(
+    vx_device_h dev, uint32_t slot,
+    uint32_t rank, uint32_t elem_bytes, Layout layout,
+    uint32_t ps_class, bool l2_only) {
+  uint32_t dcr  = VX_DCR_DXA_DESC_BASE + slot * VX_DCR_DXA_DESC_STRIDE;
+  uint32_t meta = detail::pack_meta(rank, detail::elem_size_enc(elem_bytes))
+                | ((static_cast<uint32_t>(layout) & ((1u << DXA_DESC_META_LAYOUT_BITS) - 1u))
+                   << DXA_DESC_META_LAYOUT_LSB)
+                | ((ps_class & ((1u << DXA_DESC_META_PS_CLASS_BITS) - 1u)) << DXA_DESC_META_PS_CLASS_LSB)
+                | ((l2_only ? 1u : 0u) << DXA_DESC_META_PS_L2ONLY_LSB);
+  return vx_dcr_write(dev, dcr + VX_DCR_DXA_DESC_META_OFF, meta);
+}
